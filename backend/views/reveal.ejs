<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= deck.title %></title>
<link rel="icon" href="<%= BASE %>/static/trivialSlides.svg" type="image/svg+xml">
<link rel="stylesheet" href="<%= BASE %>/reveal/reset.css">
<link rel="stylesheet" href="<%= BASE %>/reveal/reveal.css">
<link rel="stylesheet" href="<%= BASE %>/reveal/theme/<%= deck.theme %>.css">
<link rel="stylesheet" href="<%= BASE %>/reveal-plugin/highlight/monokai.css">
<!-- Styles a single code block can ask for; without one it keeps the
     monokai above (see code.js). -->
<link rel="stylesheet" href="<%= BASE %>/code-styles.css">
<link rel="stylesheet" href="<%= BASE %>/static/css/slides.css">
</head>
<body class="<%= preview ? "is-preview" : "" %>">
<div class="reveal"><div class="slides">
<%- slides %>
</div></div>

<script src="<%= BASE %>/reveal/reveal.js"></script>
<script src="<%= BASE %>/reveal-plugin/notes/notes.js"></script>
<script src="<%= BASE %>/reveal-plugin/highlight/highlight.js"></script>
<script src="<%= BASE %>/static/js/slide-effects.js"></script>
<script src="<%= BASE %>/static/js/slide-video.js"></script>
<script src="<%= BASE %>/static/js/slide-fit.js"></script>
<!-- Which keys the presenter's spare button sends. Set in the editor's
     settings dialog, stored per browser, read here. This page has a head of
     its own, so it is listed here and not in partials/head.ejs. -->
<script src="<%= BASE %>/static/js/presenter-keys.js"></script>
<script>
  // The preview inside the editor must not behave like a presentation: no
  // keyboard control (the keys belong to the form next to it), no address
  // bar anchors, no overview on click.
  var isPreview = <%- JSON.stringify(!!preview) %>;
  var indices = <%- JSON.stringify(indices) %>;

  var ready = false;

  Reveal.initialize({
    hash: !isPreview,
    keyboard: !isPreview,
    controls: !isPreview,
    progress: !isPreview,
    touch: !isPreview,
    slideNumber: isPreview ? false : "c/t",
    transition: isPreview ? "none" : <%- JSON.stringify(deck.transition) %>,
    // Highlighting belongs in the preview as well -- it is part of what the
    // slide looks like. Speaker notes are not: they open a second window.
    plugins: isPreview ? [RevealHighlight] : [RevealNotes, RevealHighlight],
  }).then(function () {
    // Only report now: initialize() jumps to the first slide itself at the
    // end and would overwrite a Reveal.slide() accepted earlier.
    ready = true;
    if (isPreview) window.parent.postMessage({ kind: "bereit" }, "*");
    // Only the slide on screen keeps its links reachable by Tab -- see
    // fokusOrdnung() below. Once at the start and then with every change.
    if (!isPreview) {
      fokusOrdnung();
      Reveal.on("slidechanged", fokusOrdnung);
    }
  });

  // --- Fullscreen on the presenter's third key --------------------------
  // A USB presenter is a keyboard. The two paging keys are what reveal.js
  // listens for anyway (PageDown / PageUp), so they need nothing from us --
  // the third key is the one that goes to waste, and it is the only one a
  // hand finds without looking while talking.
  //
  // WHICH key that is differs from stick to stick, so it is not written
  // here: the list comes from the settings dialog, where the button is
  // pressed once and whatever arrives is kept (js/presenter-keys.js). Out
  // of the box it holds what a Sharkoon "Wireless Present" (1ea7:1066)
  // sends on its third button: a plain Tab pressed once, a plain Enter
  // pressed twice quickly. Both mean the same thing to the hand that
  // pressed it, so both are in there -- and reveal.js binds neither.
  //
  // Taking Tab does cost something: in this view it is the key that reaches
  // reveal's arrows and the address under a QR code or a video. The guard
  // below hands Tab back the moment one of them HAS the focus, so tabbing
  // onward still works -- but from the slide itself Tab now goes to the
  // fullscreen instead of into that chain. On a page whose whole purpose is
  // to be driven by keys from across the room, that is the better trade.
  //
  // And a toggle of our own, because reveal has none: its F only ever
  // ENTERS fullscreen, and the way back is the browser's Escape -- which in
  // reveal is the slide overview. One key that goes both ways is what a
  // presenter key has to be; one that only ever goes in would be a trap.
  //
  // In the keydown handler itself, not later: going fullscreen needs a user
  // gesture, and a keypress is one. From a timer the browser refuses.
  // Read once, at the start: someone who changes the list while presenting
  // is not presenting.
  var VOLLBILD_TASTEN = window.presenterKeys ? window.presenterKeys.read() : ["Tab", "Enter"];

  // One press of that button means one toggle, whatever the firmware sends
  // for it. Should a double press ever send its Tab AND its Enter, the
  // second would switch straight back and the screen would appear not to
  // react at all. A quarter of a second is far longer than a key sequence
  // from one press and far shorter than two deliberate presses.
  var VOLLBILD_SPERRE = 250;
  var zuletzt = 0;

  if (!isPreview) {
    document.addEventListener("keydown", function (ev) {
      if (VOLLBILD_TASTEN.indexOf(ev.key) === -1) return;
      // With a modifier held it is somebody's shortcut, not the stick.
      if (ev.altKey || ev.ctrlKey || ev.metaKey || ev.shiftKey) return;
      // On a link or a field these keys belong to it: the address under a QR
      // code and the link under a video are real links, and taking their
      // Enter away would leave them reachable by mouse only -- and their Tab
      // is how one moves on from them.
      //
      // reveal's own arrow BUTTONS are deliberately not in that list. A
      // stray Tab from anywhere puts the focus on one of them, and from
      // then on the presenter's key would press that arrow instead of
      // switching the screen -- for an hour, unnoticed, in front of an
      // audience. Nothing is lost by it: those arrows exist for the mouse,
      // and the keyboard pages with Page Down and the arrow keys wherever
      // the focus happens to be.
      if (ev.target && ev.target.closest && ev.target.closest("a, input, textarea, select, [contenteditable]")) return;
      // Held down it stays one press -- the key repeat is the keyboard's,
      // not the speaker's.
      ev.preventDefault();
      if (ev.repeat) return;
      var jetzt = Date.now();
      if (jetzt - zuletzt < VOLLBILD_SPERRE) return;
      zuletzt = jetzt;
      vollbildUmschalten();
    });
  }

  // --- Tabbing must not leave the slide ---------------------------------
  // reveal.js keeps every slide in the document, so the links on the slides
  // that are NOT being shown stay in the focus order. Two presses of Tab
  // during a talk are enough to land on the address under a QR code three
  // slides away, and the next Enter then navigates the browser out of the
  // presentation -- in front of an audience, with no way back but the back
  // button.
  //
  // So only the slide on screen keeps its links in the order. They stay
  // clickable with the mouse and readable to a screen reader either way;
  // what they lose is being reachable by Tab from a slide nobody can see.
  function fokusOrdnung() {
    [].forEach.call(document.querySelectorAll(".slides a"), function (link) {
      var folie = link.closest("section");
      if (folie && folie.classList.contains("present")) link.removeAttribute("tabindex");
      else link.setAttribute("tabindex", "-1");
    });
  }

  // --- Opened from the editor, and meant for the whole screen ----------
  // The presenter's key in the editor opens this tab (js/editor/index.js).
  // It cannot arrive in fullscreen: a freshly opened tab has no user
  // activation of its own, and without one no browser hands over the
  // screen -- measured, at six moments and for four ways of opening, and
  // refused every time. There is no trick left to try; the rule is the
  // point of the rule.
  //
  // So the screen is taken at the first touch this tab gets, whatever it
  // is: the next press of the stick, an arrow key, a click anywhere. One
  // press opens the talk, the next one fills the screen with it -- and
  // whoever reaches for the mouse instead gets the same.
  //
  // The touch keeps doing its own job as well; only a press of the
  // presenter's own key is swallowed, because the handler above would
  // otherwise read it as the toggle it normally is and give the screen
  // straight back.
  if (!isPreview && /(?:^|[?&])vollbild=1(?:&|$)/.test(location.search)) {
    // Out of the address at once, so a reload later on does not lie in
    // wait for a touch that was never meant for it.
    try {
      history.replaceState(null, "", location.pathname + location.hash);
    } catch (e) { /* not worth a word */ }

    var einmal = function (ev) {
      document.removeEventListener("keydown", einmal, true);
      document.removeEventListener("pointerdown", einmal, true);
      if (ev && ev.type === "keydown" && VOLLBILD_TASTEN.indexOf(ev.key) !== -1) {
        ev.preventDefault();
        ev.stopImmediatePropagation();
      }
      vollbildUmschalten();
    };
    document.addEventListener("keydown", einmal, true);
    document.addEventListener("pointerdown", einmal, true);

    // And asked for straight away as well, in case this browser is willing
    // to hand the screen over unasked. Chrome has a setting for exactly
    // that -- "Automatic full screen", granted per site -- and where it is
    // granted this succeeds and the talk is on the screen with nothing
    // pressed at all. Where it is not, the refusal costs nothing: the
    // listeners above are still standing and the first touch does it.
    var sofort = document.documentElement.requestFullscreen
      && document.documentElement.requestFullscreen();
    if (sofort && sofort.then) {
      sofort.then(function () {
        document.removeEventListener("keydown", einmal, true);
        document.removeEventListener("pointerdown", einmal, true);
      }, function () { /* then the touch it is */ });
    }
  }

  function vollbildUmschalten() {
    var element = document.documentElement;
    var drin = document.fullscreenElement || document.webkitFullscreenElement;
    // The prefixed names are Safari's; every other browser has had the
    // plain ones for years (the same pair reveal.js keeps, util.js).
    var verlassen = document.exitFullscreen || document.webkitExitFullscreen;
    var hinein = element.requestFullscreen || element.webkitRequestFullscreen;
    if (drin) {
      if (verlassen) verlassen.call(document);
    } else if (hinein) {
      // A refusal is not worth a dialog in front of an audience: the slide
      // simply stays as it is.
      var versuch = hinein.call(element);
      if (versuch && versuch.catch) versuch.catch(function () { /* quiet */ });
    }
  }

  // Colours the code in a freshly drawn slide. The plugin does this for the
  // whole deck at startup; for one slide it has to be asked.
  function hervorheben(scope) {
    var plugin = Reveal.getPlugin && Reveal.getPlugin("highlight");
    if (!plugin) return;
    [].forEach.call(scope.querySelectorAll("pre code"), function (block) {
      block.parentNode.classList.add("code-wrapper");
      plugin.highlightBlock(block);
    });
  }

  if (isPreview) {
    // The editor drives the preview via postMessage: jump to a slide and
    // redraw a slide. Redrawing single slides is why the preview does not
    // flicker while typing -- the frame stays put. Plus "hallo", with which
    // the editor asks whether we are there yet.
    window.addEventListener("message", function (ev) {
      if (ev.source !== window.parent) return;
      var n = ev.data || {};
      if (n.kind === "hallo") {
        // The editor is asking because it may have missed our first
        // announcement. Before initialize() finishes we stay silent -- it
        // will ask again shortly.
        if (ready) window.parent.postMessage({ kind: "bereit" }, "*");
      } else if (n.kind === "gehezu" && indices[n.index]) {
        Reveal.slide(indices[n.index][0], indices[n.index][1]);
      } else if (n.kind === "slide") {
        // The editor's flat slide list corresponds to those <section>
        // elements that contain no <section> themselves -- the outer ones
        // are merely the stacks of vertical slides. Deliberately a filter
        // rather than :has(), which older browsers do not know.
        var sections = [].filter.call(
          document.querySelectorAll(".slides section"),
          function (s) { return !s.querySelector("section"); }
        );
        var target = sections[n.index];
        if (!target) return;
        var huelle = document.createElement("div");
        huelle.innerHTML = n.html;
        var fresh = huelle.firstElementChild;
        target.replaceWith(fresh);
        Reveal.sync();
        // sync() builds the background elements afresh, and with them goes
        // what slide-effects.js wrote on them.
        window.slideEffects();
        // The highlighter runs once, over the slides that were there when
        // reveal started. A slide redrawn while typing is not one of them.
        hervorheben(fresh);
        // Same for the fit: the slide just grew or shrank by a word, and
        // whether it quiet fits is exactly what changed.
        window.slideFit(fresh);
        if (indices[n.index]) Reveal.slide(indices[n.index][0], indices[n.index][1]);
      }
    });
  }
</script>
</body>
</html>
