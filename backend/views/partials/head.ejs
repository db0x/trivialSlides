<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== "undefined" ? title : "trivialSlides" %></title>
<link rel="icon" href="<%= BASE %>/static/trivialSlides.svg" type="image/svg+xml">
<meta name="description" content="<%= t('app.description') %>">
<meta name="theme-color" content="#1c1f23">

<!-- The card shown when someone pastes a link into Slack, Teams, Mastodon
     and the like. Text only: those services do not render SVG previews, and
     the project keeps no raster images. og:url has to be absolute, which is
     what HIER builds -- behind a reverse proxy that needs PUBLIC_URL, see
     config.js. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="trivialSlides">
<meta property="og:title" content="<%= typeof title !== "undefined" ? title : "trivialSlides" %>">
<meta property="og:description" content="<%= t('app.short') %>">
<meta property="og:url" content="<%= HIER %>">

<link rel="manifest" href="<%= BASE %>/manifest.webmanifest">
<link rel="stylesheet" href="<%= BASE %>/overlayscrollbars/styles/overlayscrollbars.css">
<link rel="stylesheet" href="<%= BASE %>/static/css/app.css">

<!-- Has to run before the first paint: an explicit theme choice must already
     be on <html>, otherwise the page flashes in the other palette for a
     frame. That is the whole reason this is inline and this small. -->
<script>
  try {
    var m = localStorage.getItem("trivialslides:theme");
    if (m) document.documentElement.setAttribute("data-theme", m);
  } catch (e) { /* private window, storage blocked */ }
</script>
<script type="application/json" id="data-texte"><%- JSON.stringify(TEXTS) %></script>
<script src="<%= BASE %>/static/js/theme.js" defer></script>
<script src="<%= BASE %>/static/js/tooltip.js" defer></script>
<script src="<%= BASE %>/static/js/language.js" defer></script>
<script src="<%= BASE %>/static/js/menu.js" defer></script>
<!-- What the presenter's spare key does, and the dialog that sets it. Both
     pages: one presents from the overview as well. -->
<script src="<%= BASE %>/static/js/autosave.js" defer></script>
<script src="<%= BASE %>/static/js/presenter-keys.js" defer></script>
<script src="<%= BASE %>/static/js/speaker-window.js" defer></script>
<script src="<%= BASE %>/static/js/prefs.js" defer></script>
<script type="module" src="<%= BASE %>/static/js/scrollbars.js"></script>
