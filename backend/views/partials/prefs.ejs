<!-- Settings that belong to the BROWSER rather than to a deck: the keys a
     presenter's spare button sends, and whatever else of that kind comes
     along. Deliberately not in the header itself -- these are set once and
     then forgotten, and the header is for what one reaches for while
     working.

     The same dialog on both pages, because one can present from the
     overview as well (js/prefs.js drives it, the values live in
     js/presenter-keys.js). -->
<dialog id="prefs-dialog" class="dialog dialog-schmal">
  <form method="dialog" class="dialog-head">
    <h2><%= t('prefs.title') %></h2>
    <button class="button button-quiet" value="close"><%= t('dialog.close') %></button>
  </form>
  <div class="dialog-content">
    <div class="field">
      <span class="field-label"><%= t('prefs.presenter') %></span>
      <!-- Filled by the page: which keys these are is only known once they
           have been pressed. -->
      <div id="prefs-keys" class="key-list"></div>
      <div class="prefs-row">
        <button type="button" id="prefs-record" class="button"><%= t('prefs.record') %></button>
        <button type="button" id="prefs-reset" class="button button-quiet"><%= t('prefs.reset') %></button>
      </div>
      <!-- role=status, so a screen reader hears what was recorded without
           the focus having to move there. -->
      <p id="prefs-state" class="hint" role="status"></p>
      <p class="hint"><%= t('prefs.presenterNote') %></p>
    </div>

    <!-- The other key: the one that starts the talk from the editor. The
         same three controls, driven by the same code with a drawer of its
         own (js/prefs.js). Removing every key here switches the whole
         behaviour off -- which is what an empty list has always meant for
         the key above it. -->
    <div class="field">
      <span class="field-label"><%= t('prefs.start') %></span>
      <div id="prefs-start-keys" class="key-list"></div>
      <div class="prefs-row">
        <button type="button" id="prefs-start-record" class="button"><%= t('prefs.record') %></button>
        <button type="button" id="prefs-start-reset" class="button button-quiet"><%= t('prefs.reset') %></button>
      </div>
      <p id="prefs-start-state" class="hint" role="status"></p>
      <p class="hint"><%= t('prefs.startNote') %></p>
    </div>
    <!-- Whether the editor writes the file by itself. Here and not in the
         header, like everything else in this dialog: it is decided once
         and then worked under, and switching it costs a deck nothing --
         nothing of it is written into a .md (js/autosave.js). -->
    <div class="field">
      <span class="field-label"><%= t('prefs.autosave') %></span>
      <label class="switch-line">
        <input type="checkbox" id="prefs-autosave" class="switch">
        <span><%= t('prefs.autosaveOn') %></span>
      </label>
      <p class="hint"><%= t('prefs.autosaveNote') %></p>
    </div>

    <!-- How S opens the speaker view while presenting. Three ways and no
         right one, so they stand here as three named choices rather than
         as a switch: a window of the browser's (a popup, which is the
         only kind a page may ask for), a tab, or the application of the
         desktop (desktop/, js/speaker-window.js). -->
    <fieldset class="field choice-field">
      <legend class="field-label"><%= t('prefs.speakerView') %></legend>
      <% ['window', 'tab', 'app'].forEach(function (way) { %>
        <label class="choice-line">
          <input type="radio" name="speaker-window" class="choice" value="<%= way %>">
          <span><%= t('prefs.speakerView.' + way) %></span>
        </label>
      <% }); %>
      <p class="hint"><%= t('prefs.speakerViewNote') %></p>
    </fieldset>

    <p class="hint prefs-scope"><%= t('prefs.note') %></p>
  </div>
</dialog>
