<!doctype html>
<html lang="<%= t('html.lang') %>">
<head>
<%- include("partials/head", { title: "trivialSlides" }) %>
</head>
<body class="page-overview">
  <header class="head">
    <a class="brand" href="<%= BASE %>/"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32"><span class="brand-word">trivialSlides<small class="brand-version">v<%= VERSION %></small></span></a>
    <%- include("partials/settings") %>
  </header>

  <main class="content">
    <% if (!decks.length) { %>
      <p class="empty"><%= t('overview.empty') %></p>
    <% } %>
    <ul class="deck-list">
      <% decks.forEach(function (d) { %>
        <li>
          <a href="<%= BASE %>/d/<%= d.slug %>">
            <span class="deck-title"><%= d.title %></span>
            <span class="deck-meta"><%= t("overview.slides", { n: d.slides }) %> &middot; <%= t("overview.changed", { time: new Date(d.changed).toLocaleString(t("date.locale"), { dateStyle: "medium", timeStyle: "short" }) }) %></span>
          </a>
          <span class="deck-actions">
            <a class="button button-quiet button-icon deck-vorfuehren" data-tip="<%= t('header.present') %>" aria-label="<%= t('header.present') %>"
               href="<%= BASE %>/d/<%= d.slug %>/present" target="_blank" rel="noopener"></a>
          </span>
        </li>
      <% }); %>
      <!-- The new deck sits where a new deck belongs: at the end of the
           list, in the same shape as the rest of them. -->
      <li class="deck-fresh">
        <button type="button" id="deck-fresh" class="deck-fresh-button">
          <span class="deck-fresh-zeichen" aria-hidden="true"></span>
          <span class="deck-title"><%= t('overview.new') %></span>
        </button>
      </li>
      <!-- And beside it the other way of starting one: out of material
           somebody already has (partials/ai-new.ejs). The same shape as
           the button above, because it answers the same question -- how
           does a talk come into being here. -->
      <% if (ai) { %>
        <li class="deck-fresh">
          <button type="button" id="deck-compose" class="deck-fresh-button">
            <span class="deck-compose-zeichen" aria-hidden="true"></span>
            <span class="deck-title"><%= t('ai.newOpen') %></span>
          </button>
        </li>
      <% } %>
    </ul>
  </main>

  <dialog id="fresh-dialog" class="dialog dialog-schmal">
    <form method="dialog" class="dialog-head">
      <h2><%= t('dialog.newTitle') %></h2>
      <button class="button button-quiet" value="abbruch"><%= t('dialog.close') %></button>
    </form>
    <form method="post" action="<%= BASE %>/new" class="dialog-content">
      <label class="field">
        <span class="field-label"><%= t('dialog.title') %></span>
        <input id="fresh-title" name="title" maxlength="120" required
               placeholder="<%= t('dialog.placeholder') %>" autocomplete="off">
      </label>
      <p class="hint"><%= t('dialog.note') %></p>
      <div class="dialog-fuss">
        <button type="button" class="button" data-close><%= t('dialog.cancel') %></button>
        <button type="submit" class="button button-haupt"><%= t('dialog.create') %></button>
      </div>
    </form>
  </dialog>

  <% if (ai) { %><%- include("partials/ai-new") %><% } %>

  <script src="<%= BASE %>/static/js/overview.js" defer></script>
  <!-- A module, unlike the script above: it shares the reader for the
       answer with the editor's own dialog (js/ai-run.js), and sharing it
       is the point -- both pages ask for a deck the same way. -->
  <% if (ai) { %>
    <script>window.SLIDES_BASE = <%- JSON.stringify(BASE) %>;</script>
    <script type="module" src="<%= BASE %>/static/js/overview-ai.js"></script>
  <% } %>
<%- include("partials/prefs") %>

</body>
</html>
