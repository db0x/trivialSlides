<!doctype html>
<html lang="de">
<head>
<%- include("partials/head", { titel: "trivialSlides" }) %>
</head>
<body class="seite-uebersicht">
  <header class="kopf">
    <a class="marke" href="<%= BASE %>/"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32">trivialSlides</a>
    <button id="theme-umschalter" class="knopf knopf-still knopf-icon" type="button"></button>
  </header>

  <main class="inhalt">
    <% if (!decks.length) { %>
      <p class="leer">Noch kein Vortrag da. Der Kasten unten legt den ersten an.</p>
    <% } %>
    <ul class="deckliste">
      <% decks.forEach(function (d) { %>
        <li>
          <a href="<%= BASE %>/d/<%= d.slug %>">
            <span class="deck-titel"><%= d.titel %></span>
            <span class="deck-meta"><%= d.folien %> Folien &middot; zuletzt geaendert <%= new Date(d.geaendert).toLocaleString("de-DE", { dateStyle: "medium", timeStyle: "short" }) %></span>
          </a>
          <span class="deck-aktionen">
            <a class="knopf knopf-still knopf-icon deck-vorfuehren" title="Vorfuehren" aria-label="Vorfuehren"
               href="<%= BASE %>/d/<%= d.slug %>/praesentation" target="_blank" rel="noopener"></a>
          </span>
        </li>
      <% }); %>
      <!-- The new deck sits where a new deck belongs: at the end of the
           list, in the same shape as the rest of them. -->
      <li class="deck-neu">
        <button type="button" id="deck-neu" class="deck-neu-knopf">
          <span class="deck-neu-zeichen" aria-hidden="true"></span>
          <span class="deck-titel">Neuer Vortrag</span>
        </button>
      </li>
    </ul>
  </main>

  <dialog id="neu-dialog" class="dialog dialog-schmal">
    <form method="dialog" class="dialog-kopf">
      <h2>Neuer Vortrag</h2>
      <button class="knopf knopf-still" value="abbruch">Schliessen</button>
    </form>
    <form method="post" action="<%= BASE %>/neu" class="dialog-inhalt">
      <label class="feld">
        <span class="feld-name">Titel</span>
        <input id="neu-titel" name="titel" maxlength="120" required
               placeholder="Woruber geht der Vortrag?" autocomplete="off">
      </label>
      <p class="hilfe">Der Titel steht auf der ersten Folie und laesst sich spaeter jederzeit aendern.</p>
      <div class="dialog-fuss">
        <button type="button" class="knopf" data-schliessen>Abbrechen</button>
        <button type="submit" class="knopf knopf-haupt">Anlegen</button>
      </div>
    </form>
  </dialog>

  <script src="<%= BASE %>/static/js/uebersicht.js" defer></script>
</body>
</html>
