<!doctype html>
<html lang="<%= t('html.lang') %>">
<head>
<%- include("partials/head", { title: deck.title || "Vortrag" }) %>
<!-- Only the editor picks colours, so the overview is spared this. -->
<link rel="stylesheet" href="<%= BASE %>/coloris/dist/coloris.css">
<!-- Only the editor has a preview to shape, so this one is not in the
     shared head either. -->
<script src="<%= BASE %>/static/js/preview-format.js" defer></script>
</head>
<body class="side-editor">

<header class="head">
  <a class="brand" href="<%= BASE %>/" data-tip="<%= t('header.allTalks') %>"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32"><span class="brand-word">trivialSlides<small class="brand-version">v<%= VERSION %></small></span></a>

  <input id="deck-title" class="deck-title-field" value="<%= deck.title %>" maxlength="120" aria-label="<%= t('header.titleField') %>">

  <label class="header-field"><%= t('header.theme') %>
    <select id="deck-theme">
      <% themes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.theme ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <label class="header-field"><%= t('header.transition') %>
    <select id="deck-transition">
      <% transitions.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.transition ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <span id="save-state" class="save-state" role="status"></span>

  <!-- Presenting is two things: from the top, or from wherever the editor
       stands. On the first slide those two are the same thing, so there the
       button stays the plain link it always was and the menu keeps out of
       the way -- a choice between one thing is a click for nothing.
       index.js swaps the two as the slide changes and writes the address of
       the current slide into the second entry. -->
  <a class="button button-icon header-present present-direct" data-tip="<%= t('header.present') %>"
     aria-label="<%= t('header.present') %>"
     href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"></a>
  <details class="menu present-menu" hidden>
    <summary class="button button-icon header-present" data-tip="<%= t('header.present') %>"
             aria-label="<%= t('header.present') %>"></summary>
    <div class="menu-content" role="menu">
      <a class="menu-item present-from-start" role="menuitem"
         href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"><span
         class="menu-item-icon" aria-hidden="true"></span><%= t('header.presentFromStart') %></a>
      <a id="present-from-current" class="menu-item present-from-current" role="menuitem"
         href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"><span
         class="menu-item-icon" aria-hidden="true"></span><%= t('header.presentFromCurrent') %></a>
    </div>
  </details>
  <details class="menu">
    <summary class="button button-icon header-download" data-tip="<%= t('header.download') %>" aria-label="<%= t('header.download') %>"></summary>
    <div class="menu-content">
      <a href="<%= BASE %>/d/<%= slug %>/export.html"><%= t('editor.exportHtml') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/export.pdf"><%= t('editor.exportPdf') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/deck.md"><%= t('editor.exportMd') %></a>
    </div>
  </details>
  <button id="language-toggle" class="button button-quiet language" type="button"
      data-target="<%= LANGUAGE === 'de' ? 'en' : 'de' %>"
      data-tip="<%= t('header.switchLanguage') %>"
      aria-label="<%= t('header.switchLanguage') %>"><%= LANGUAGE === 'de' ? 'en' : 'de' %></button>
  <button id="theme-toggle" class="button button-quiet button-icon" type="button"></button>
</header>

<main class="editor">

  <!-- Left: the slides as a list. Reorder by dragging. -->
  <aside class="column slide-list">
    <span class="columns-head"><%= t('column.slides') %></span>
    <ol id="slide-list" class="slides"></ol>
    <button id="slide-new" class="button button-wide" type="button"><%= t('editor.slideNew') %></button>
  </aside>

  <!-- Middle: the form for the selected slide. Nowhere here is there any
       Markdown syntax -- that is the whole point of the exercise. -->
  <section class="column form">
    <fieldset class="fieldset">
      <legend><%= t('editor.structure') %></legend>
      <div id="layout-tiles" class="layout-tiles">
        <% layouts.forEach(function (l) { %>
          <button type="button" class="layout-tile" data-layout="<%= l.id %>" data-tip="<%= l.hint %>">
            <span class="mini mini-<%= l.id %>" aria-hidden="true"></span>
            <span class="layout-name"><%= l.label %></span>
          </button>
        <% }); %>
      </div>
      <p id="layout-hint" class="hint"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend><%= t('editor.content') %></legend>

      <label class="field">
        <span class="field-label"><%= t('editor.heading') %></span>
        <input id="slide-title" maxlength="200" placeholder="<%= t('editor.headingPlaceholder') %>">
      </label>

      <div class="field">
        <span class="field-label"><%= t('editor.text') %></span>
        <div class="toolbar" role="toolbar" aria-label="<%= t('editor.toolbar') %>">
          <button type="button" class="tool-icon" data-command="bold" data-tip="<%= t('tool.boldTip') %>" aria-label="<%= t('tool.bold') %>"></button>
          <button type="button" class="tool-icon" data-command="italic" data-tip="<%= t('tool.italicTip') %>" aria-label="<%= t('tool.italic') %>"></button>
          <button type="button" class="tool-icon" data-command="strikeThrough" data-tip="<%= t('tool.strikethrough') %>" aria-label="<%= t('tool.strikethrough') %>"></button>
          <button type="button" class="tool-icon" data-command="insertUnorderedList" data-tip="<%= t('tool.bulletList') %>" aria-label="<%= t('tool.bulletList') %>"></button>
          <button type="button" class="tool-icon" data-command="insertOrderedList" data-tip="<%= t('tool.numberedList') %>" aria-label="<%= t('tool.numberedList') %>"></button>
          <button type="button" class="tool-icon" data-command="link" data-tip="<%= t('tool.link') %>" aria-label="<%= t('tool.link') %>"></button>
          <span class="toolbar-divider"></span>
          <button type="button" class="tool-icon" data-command="fragment" data-tip="<%= t('tool.fragmentTip') %>" aria-label="<%= t('tool.fragment') %>"></button>
          <!-- Code is the one thing in this bar that the rich-text field
               cannot hold, so it does not run through execCommand and it
               stays usable in source mode -- that is where it lands. -->
          <button type="button" id="code-insert" class="tool-icon" data-tip="<%= t('tool.codeTip') %>" aria-label="<%= t('tool.code') %>"></button>
          <span class="toolbar-divider"></span>
          <!-- Where the text sits in relation to the player, on a video
               slide. In the bar it is the icon of the side in force and
               nothing else; the words are in the menu, where there is room
               for them. Like the code button it is not a rich-text command,
               so it keeps working in source mode. -->
          <details id="text-side-menu" class="menu menu-tool"
                   data-name="<%= t('editor.textSide') %>" hidden>
            <summary id="text-side-button" class="tool-icon tool-side" data-side="oben"
                     aria-label="<%= t('editor.textSide') %>"></summary>
            <div class="menu-content" role="menu">
              <% textSides.forEach(function (s) { %>
                <button type="button" class="menu-item tool-side" role="menuitemradio"
                        aria-checked="false" data-side="<%= s.id %>"><span
                        class="menu-item-icon" aria-hidden="true"></span><%= s.name %></button>
              <% }); %>
            </div>
          </details>
          <!-- How wide the text may get beside the player. A percentage
               says itself, so this one wears its value rather than an icon
               -- and it is switched off, not hidden, while the text is
               above or below the player: there it has the full width and
               the number would be a promise the slide does not keep. -->
          <!-- Two names, because the thing the text stands beside differs by
               layout: a picture on image-links/-rechts, a player on video.
               Both travel with the button and the page picks the fitting
               one (js/editor/index.js) -- naming it after the layout on the
               server would mean re-rendering the bar on every layout
               change. -->
          <details id="text-width-menu" class="menu menu-tool" hidden
                   data-name-image="<%= t('editor.textWidthImage') %>"
                   data-name-video="<%= t('editor.textWidthVideo') %>"
                   data-name-qr="<%= t('editor.textWidthQr') %>">
            <summary id="text-width-button" class="tool-word"></summary>
            <div class="menu-content" role="menu">
              <% textWidths.forEach(function (b) { %>
                <button type="button" class="menu-item" role="menuitemradio"
                        aria-checked="false" data-width="<%= b %>"><%= b %>&nbsp;%</button>
              <% }); %>
            </div>
          </details>
          <span class="toolbar-divider"></span>
          <button type="button" id="source-toggle" class="tool-icon" data-tip="<%= t('tool.sourceTip') %>" aria-label="<%= t('tool.source') %>"></button>
        </div>
        <!-- The frame, not the field, is what scrolls: OverlayScrollbars
             builds its own DOM inside whatever it is attached to, and the
             editor reads the content field's innerHTML back as Markdown. -->
        <div id="content-frame" class="field-frame">
          <div id="slide-content" class="content-field" contenteditable="true" spellcheck="true"
               data-placeholder="<%= t('editor.textPlaceholder') %>"></div>
        </div>
        <div id="source-frame" class="field-frame" hidden>
          <textarea id="slide-source-text" class="source-field" spellcheck="false"></textarea>
        </div>
        <p id="source-note" class="hint" hidden>
          <%= t('editor.sourceNote') %>
        </p>
      </div>

      <div class="field field-image" hidden>
        <span class="field-label"><%= t('editor.image') %></span>
        <div class="image-row">
          <img id="image-preview" class="image-preview" alt="" hidden>
          <div class="image-buttons">
            <button type="button" id="image-choose" class="button"><%= t('editor.imageChoose') %></button>
            <button type="button" id="image-remove" class="button button-quiet" hidden><%= t('editor.imageRemove') %></button>
          </div>
        </div>
      </div>

      <!-- The link as it sits in the clipboard; what lands in the file is
           the id inside it (video.js). The pattern is the server's, so the
           page recognises a link the same way the server does. -->
      <label class="field field-video" hidden>
        <span class="field-label"><%= t('editor.video') %></span>
        <input id="slide-video" type="text" maxlength="200" spellcheck="false"
               placeholder="<%= t('editor.videoPlaceholder') %>"
               data-pattern="<%= videoPattern %>">
        <span id="video-note" class="hint"></span>
      </label>

      <!-- The address the code points at. Same shape as the video field:
           whatever is pasted goes to the server as it stands, and the
           server decides what a usable address is (qr.js). -->
      <label class="field field-url" hidden>
        <span class="field-label"><%= t('editor.url') %></span>
        <input id="slide-url" type="text" maxlength="300" spellcheck="false"
               placeholder="<%= t('editor.urlPlaceholder') %>">
        <span id="url-note" class="hint"></span>
      </label>

      <!-- The code's own colours. Its own block and not in the colour group
           below, because those belong to the slide and these to the one
           picture on it -- and because the group is folded away by default,
           where somebody looking for the code's colours would not think to
           look. Clearing the background is what makes it see-through. -->
      <div class="field field-qr-colors" hidden>
        <span class="field-label"><%= t('editor.qrColors') %></span>
        <div class="color-row">
          <label class="color-choice">
            <input id="qr-color" class="color-field" type="text" value="" aria-label="<%= t('editor.qrColor') %>">
            <span><%= t('editor.qrColor') %></span>
          </label>
          <label class="color-choice">
            <input id="qr-background" class="color-field" type="text" value="" aria-label="<%= t('editor.qrBackground') %>">
            <span><%= t('editor.qrBackground') %></span>
          </label>
          <label class="color-choice">
            <input id="qr-text-color" class="color-field" type="text" value="" aria-label="<%= t('editor.qrTextColor') %>">
            <span><%= t('editor.qrTextColor') %></span>
          </label>
        </div>
        <p class="hint"><%= t('editor.qrColorsHint') %></p>
      </div>

      <label class="field field-source" hidden>
        <span class="field-label"><%= t('editor.source') %></span>
        <input id="slide-source" maxlength="200" placeholder="<%= t('editor.sourcePlaceholder') %>">
      </label>
    </fieldset>

    <!-- Colours, gradient and effect are the things one reaches for after a
         while, not at the start -- so the group folds away, and starts
         folded. <details> rather than a button of our own: the browser
         brings the keyboard, the marker and the semantics with it. The
         choice is remembered (js/editor/index.js), because someone who has
         opened it once is usually past the start. -->
    <details id="colors-group" class="fieldset fieldset-fold">
      <summary>
        <%= t('editor.colors') %>
        <span class="fold-mark" data-tip="<%= t('editor.colorsCustom') %>"
              aria-label="<%= t('editor.colorsCustom') %>"></span>
      </summary>
      <div class="color-row">
        <label class="color-choice">
          <input id="background-custom" class="color-field" type="text" value="" aria-label="<%= t('editor.background') %>">
          <span><%= t('editor.background') %></span>
        </label>
        <label class="color-choice">
          <input id="text-color-custom" class="color-field" type="text" value="" aria-label="<%= t('editor.textColor') %>">
          <span><%= t('editor.textColor') %></span>
        </label>
      </div>

      <!-- The gradient, twice over: the swatches for picking one, the field
           below for writing one. The swatches come from gradients.js, which
           a deck collection extends through decks/gradients.json -- so this
           row is as long as someone made it, not eight items by design.
           Each swatch wears its own gradient, which is why the value is in
           the style attribute: a stylesheet cannot know them. -->
      <div class="field field-gradient">
        <span class="field-label"><%= t('editor.gradient') %></span>
        <div id="gradient-presets" class="gradient-presets" role="group" aria-label="<%= t('editor.gradientPresets') %>">
          <button type="button" class="gradient-probe gradient-none" data-gradient=""
                  data-tip="<%= t('editor.gradientNone') %>" aria-label="<%= t('editor.gradientNone') %>"></button>
          <% gradients.forEach(function (v) { %>
            <button type="button" class="gradient-probe" data-gradient="<%= v.css %>"
                    style="background-image: <%= v.css %>"
                    data-tip="<%= v.name %>" aria-label="<%= v.name %>"></button>
          <% }); %>
        </div>
        <input id="slide-gradient" class="gradient-field" type="text" spellcheck="false"
               maxlength="<%= gradientMax %>" pattern="<%= gradientPattern %>"
               placeholder="<%= t('editor.gradientPlaceholder') %>" aria-label="<%= t('editor.gradientCustom') %>">
        <p id="gradient-hint" class="hint"><%= t('editor.gradientNote') %></p>
      </div>

      <!-- Animated backgrounds. A name, not a value -- what it looks like
           is in slides.css (see effects.js), so a tile can only show a
           quiet of it. -->
      <div class="field field-effect">
        <span class="field-label"><%= t('editor.effect') %></span>
        <div id="effect-tiles" class="effect-tiles" role="group" aria-label="<%= t('editor.effect') %>">
          <button type="button" class="effect-tile effect-none" data-effect=""
                  data-tip="<%= t('editor.effectNone') %>" aria-label="<%= t('editor.effectNone') %>"></button>
          <% effects.forEach(function (e) { %>
            <button type="button" class="effect-tile" data-effect="<%= e.id %>"
                    data-tip="<%= e.name %>" aria-label="<%= e.name %>"></button>
          <% }); %>
        </div>
        <p class="hint"><%= t('editor.effectNote') %></p>
      </div>
    </details>
  </section>

  <!-- Right: real reveal.js, not a replica. What stands here is what
       stands on the wall later. -->
  <aside class="column preview">
    <span class="columns-head"><%= t('column.preview') %></span>
    <div class="preview-frame">
      <iframe id="preview" title="<%= t('column.preview') %>" src="<%= BASE %>/d/<%= slug %>/preview"></iframe>
    </div>
    <p class="hint preview-hint"><%= t('editor.previewNote') %></p>
    <!-- The shape of the screen the talk will run on. reveal.js fits the
         slide into whatever it is given, so putting the preview into that
         shape is the one honest way to see beforehand what a 4:3 projector
         will make of a slide. The deck is untouched by it -- see
         preview-format.js.

         Icon and menu in one <label>, so the picture is not a dead
         decoration: a click on it opens the menu. The tooltip hangs on the
         label for the same reason. -->
    <label class="preview-format-field" data-tip="<%= t('editor.previewFormat') %>">
      <span class="preview-screen" aria-hidden="true"></span>
      <select id="preview-format" class="preview-format"
              aria-label="<%= t('editor.previewFormat') %>">
        <% previewFormats.forEach(function (f) { %>
          <option value="<%= f %>"><%= f %></option>
        <% }); %>
      </select>
    </label>
  </aside>
</main>

<!-- Inserting a code block: language and, for this one block, a style.
     Both end up in the fence (```java hl=github), so the .md keeps saying
     what it means in any other renderer too. -->
<dialog id="code-dialog" class="dialog">
  <form method="dialog" class="dialog-head">
    <h2 id="code-title"><%= t('dialog.codeTitle') %></h2>
    <button class="button button-quiet" value="abbruch"><%= t('dialog.close') %></button>
  </form>
  <form method="dialog" class="dialog-content" id="code-form">
    <label class="field">
      <span class="field-label"><%= t('dialog.codeLanguage') %></span>
      <select id="code-language">
        <% codeLanguages.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.label %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span class="field-label"><%= t('dialog.codeStyle') %></span>
      <select id="code-style">
        <option value=""><%= t('dialog.codeStyleDefault') %></option>
        <% codeStyles.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.id %><%= s.light ? " — " + t('dialog.codeLight') : "" %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span class="field-label"><%= t('dialog.codeText') %></span>
      <textarea id="code-text" class="code-eingabe" rows="8" spellcheck="false"
                placeholder="<%= t('dialog.codePlaceholder') %>"></textarea>
    </label>
    <label class="field field-schmal code-fragment-line">
      <input type="checkbox" id="code-fragment">
      <span><%= t('dialog.codeFragment') %></span>
    </label>
    <p id="code-note" class="hint"><%= t('dialog.codeNote') %></p>
    <div class="dialog-fuss">
      <button type="button" class="button" data-close><%= t('dialog.cancel') %></button>
      <button type="submit" id="code-ok" class="button button-haupt" value="einfuegen"><%= t('dialog.codeInsert') %></button>
    </div>
  </form>
</dialog>

<!-- Notices. One dialog for all of them; the text arrives when it is opened
     (js/editor/index.js). Ours rather than the browser's alert for the same
     reason the tooltips are ours: that one cannot be styled, it names the
     host ("localhost:8888 says"), and it looks like a visitor from another
     program. -->
<dialog id="note-dialog" class="dialog dialog-schmal">
  <form method="dialog" class="dialog-head">
    <h2><%= t('dialog.noteTitle') %></h2>
    <button class="button button-quiet" value="ok"><%= t('dialog.close') %></button>
  </form>
  <form method="dialog" class="dialog-content">
    <p id="note-text"></p>
    <div class="dialog-fuss">
      <button class="button button-haupt" value="ok" autofocus><%= t('dialog.understood') %></button>
    </div>
  </form>
</dialog>

<!-- Image picker -->
<dialog id="image-dialog" class="dialog">
  <form method="dialog" class="dialog-head">
    <h2><%= t('editor.imageChoose') %></h2>
    <button class="button button-quiet" value="abbruch"><%= t('dialog.close') %></button>
  </form>
  <div class="dialog-content">
    <label class="button button-haupt upload">
      <%= t('editor.imageUpload') %>
      <input type="file" id="image-file" accept="image/*" multiple hidden>
    </label>
    <div id="image-gallery" class="image-gallery"></div>
    <p id="image-empty" class="hint" hidden><%= t('editor.imageNone') %></p>
  </div>
</dialog>

<script type="application/json" id="data-deck"><%- JSON.stringify(deck) %></script>
<script type="application/json" id="data-layouts"><%- JSON.stringify(layouts) %></script>
<script type="application/json" id="data-images"><%- JSON.stringify(images) %></script>
<script>window.SLIDES_BASE = <%- JSON.stringify(BASE + "/d/" + slug) %>;</script>
<script type="module" src="<%= BASE %>/static/js/editor/index.js"></script>
</body>
</html>
