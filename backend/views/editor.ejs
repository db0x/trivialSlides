<!doctype html>
<html lang="<%= t('html.lang') %>">
<head>
<%- include("partials/head", { title: deck.title || "Vortrag" }) %>
<!-- Only the editor picks colours, so the overview is spared this. -->
<link rel="stylesheet" href="<%= BASE %>/coloris/dist/coloris.css">
<!-- Only the editor has a preview to shape, so this one is not in the
     shared head either. -->
<script src="<%= BASE %>/static/js/preview-format.js" defer></script>
<!-- The same for the line between the form and the preview: nowhere else is
     there anything to drag. -->
<script src="<%= BASE %>/static/js/column-split.js" defer></script>
<!-- And the same for the slide list's two scroll buttons. -->
<script src="<%= BASE %>/static/js/slide-list-scroll.js" defer></script>

<!-- The editor assembling itself when a deck is opened (app.css). Inline
     and here rather than in a file of its own, for the same reason as the
     theme above: a piece that is to fade in has to be invisible BEFORE the
     first paint, and anything fetched afterwards arrives to find it already
     on the screen. Nothing but the attribute is decided here -- what moves,
     and how far, is the stylesheet's business, and which cards take part is
     js/entrance.js'. A system asking for less movement is asked first and
     gets no attribute at all, which leaves every one of those rules dead. -->
<script>
  try {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.setAttribute("data-enter", "1");
    }
  } catch (e) { /* no matchMedia, no animation -- the page is the same page */ }
</script>
<script src="<%= BASE %>/static/js/entrance.js" defer></script>
</head>
<body class="side-editor">

<header class="head">
  <a class="brand" href="<%= BASE %>/" data-tip="<%= t('header.allTalks') %>"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32"><span class="brand-word">trivialSlides<small class="brand-version">v<%= VERSION %></small></span></a>

  <input id="deck-title" class="deck-title-field" value="<%= deck.title %>" maxlength="120" aria-label="<%= t('header.titleField') %>">

  <!-- ONE SHAPE PER KIND OF CONSEQUENCE. That is the whole rule this bar
       is built on, and it is why what used to be five identical grey
       squares in a tray is now three different shapes:

         a rounded PILL carrying a value   the deck IS this, and clicking
                                           offers the other values
         a square GHOST button with a word  something OPENS
         the one FILLED button             the way forward

       Before this, the pills and the tray looked like siblings -- same
       height, same pill radius, same sunken ground -- and behaved
       nothing alike: one showed state, the other hid five different
       kinds of action behind five anonymous icons. Nothing in the bar
       could be predicted without pressing it once.

       Round is state, square is action; and anything the bar cannot
       carry is reachable by name with Ctrl+K (js/editor/palette.js).

       The deck's look and its transition, then: menus of this app's own
       rather than <select>s, for the same reason as the preview's format
       further down -- a native one brings the operating system's dropdown
       with it, which is the only thing on the page that does not look
       like the page.

       Each is ONE control: the name of the setting inside the pill, small
       and grey, and the value next to it in the text colour. The name
       rides on data-label and is drawn by the stylesheet, NOT written
       into the button: index.js sets the value with textContent, which
       would wipe any element put inside. A ::before survives that. -->
  <div class="head-group head-deck">
    <details id="deck-theme-menu" class="menu header-menu">
      <summary id="deck-theme" class="header-value" data-value="<%= deck.theme %>"
               data-label="<%= t('header.theme') %>"
               aria-label="<%= t('header.theme') %>"><%= deck.theme %></summary>
      <div class="menu-content menu-scroll" role="menu">
        <% themes.forEach(function (name) { %>
          <button type="button" role="menuitemradio" data-value="<%= name %>"
                  aria-checked="<%= name === deck.theme ? 'true' : 'false' %>"
                  class="menu-item<%= name === deck.theme ? ' is-active' : '' %>"><%= name %></button>
        <% }); %>
      </div>
    </details>

    <details id="deck-transition-menu" class="menu header-menu">
      <summary id="deck-transition" class="header-value" data-value="<%= deck.transition %>"
               data-label="<%= t('header.transition') %>"
               aria-label="<%= t('header.transition') %>"><%= deck.transition %></summary>
      <div class="menu-content" role="menu">
        <% transitions.forEach(function (name) { %>
          <button type="button" role="menuitemradio" data-value="<%= name %>"
                  aria-checked="<%= name === deck.transition ? 'true' : 'false' %>"
                  class="menu-item<%= name === deck.transition ? ' is-active' : '' %>"><%= name %></button>
        <% }); %>
      </div>
    </details>
  </div>

  <!-- WHAT OPENS. Four buttons, and every one of them says its word --
       which is the whole difference from the tray that stood here before.
       The tray's five icons hid five different kinds of consequence:
       writing a file, unfolding a panel, two dialogs and a menu, all
       behind identical grey squares on one sunken ground. The ground was
       what made them look like one thing. It is gone, each button carries
       its name, and the one that did not belong among them -- Save, which
       writes rather than opens -- has gone to stand with the word that
       reports on it.

       The word is the NAME, with no aria-label over it -- except on the
       AI button, whose word is two letters and whose long form contains
       them. An aria-label replaces the visible text rather than adding to
       it, so one reading "Quellcode editieren" over a button reading
       "Quelltext" would leave the word on the screen addressing nothing:
       voice control hears what the label says, the user says what the
       button says, and the two never meet. The long form belongs in the
       tooltip, which adds to the name instead of replacing it.

       The words fold away on a narrow bar (app.css) as a clip rather than
       display:none, so they stay in the accessible name at every width. -->
  <div class="head-group head-open">
    <!-- The file itself, to be read and written. It stood in the menu while
         it could only be looked at; now that it can be edited it is one of
         the things one reaches for while working
         (js/editor/deck-source.js). -->
    <button type="button" id="deck-source-open" class="head-tool head-source"
            aria-expanded="false" aria-controls="deck-source-view"
            data-tip="<%= t('header.deckSource') %>"><span
            class="head-tool-word"><%= t('header.deckSourceWord') %></span></button>
    <!-- The two strips that stand on every slide (partials/bands.ejs). They
         belong to the DECK, like the theme and the transition at the other
         end of this header, and they are looked at again while a talk is
         being written -- a colour changed, a logo swapped -- rather than
         set once per browser, which is what the settings menu is for.

         Not a pill with a value, although it belongs to the deck like the
         two pills do: a band has no on and off to show. It exists when it
         has been given words or a logo, which is four fields and a dialog
         -- so it is one of the things that OPEN. -->
    <button type="button" id="bands-open" class="head-tool head-bands"
            data-tip="<%= t('header.bands') %>"><span
            class="head-tool-word"><%= t('header.bandsWord') %></span></button>
    <!-- This deck, changed by instruction (partials/ai.ejs). Rendered only
         where a key is configured: without one this is not a feature that is
         switched off, it is a feature the instance does not have -- the same
         way the PDF export is absent where no browser was found.
         BUILDING a deck out of material is the other half of the job and sits
         on the overview, where talks begin (views/index.ejs). -->
    <% if (ai) { %>
      <!-- The one that keeps an aria-label: its word is two letters, and
           the long form has those two letters in it -- so the label says
           more without saying something else, and "KI" still addresses
           the button it is written on. -->
      <button type="button" id="ai-open" class="head-tool head-ai"
              data-tip="<%= t('ai.changeOpen') %>" aria-label="<%= t('ai.changeOpen') %>"><span
              class="head-tool-word"><%= t('header.aiWord') %></span></button>
    <% } %>
    <!-- The three ways out of here. It is the one of the four that opens a
         MENU rather than a panel or a dialog, so it is the one that wears a
         caret: the shape says how far the next click goes. -->
    <details id="deck-export-menu" class="menu head-open-menu">
      <summary class="head-tool head-export has-caret" data-tip="<%= t('header.download') %>"><span
               class="head-tool-word"><%= t('header.exportWord') %></span></summary>
      <div class="menu-content">
        <a href="<%= BASE %>/d/<%= slug %>/export.html"><%= t('editor.exportHtml') %></a>
        <a href="<%= BASE %>/d/<%= slug %>/export.pdf"><%= t('editor.exportPdf') %></a>
        <a href="<%= BASE %>/d/<%= slug %>/deck.md"><%= t('editor.exportMd') %></a>
      </div>
    </details>
  </div>

  <!-- WHAT THE FILE IS DOING, and the button that acts on it. One slot,
       and it holds its width whatever stands in it: the Save button comes
       and goes with the autosave setting (js/autosave.js,
       js/editor/index.js), and while it lived in the tray its coming and
       going shifted everything to its right -- the Present button among
       them. A button that moves its neighbours is a button one cannot
       learn the place of.

       The word is now there in EVERY state, which it was not: with
       autosave on the bar used to say nothing at all, so the one question
       a writer asks all day -- is my work safe -- was the one thing the
       header would not answer. -->
  <div class="head-group head-state">
    <span id="save-state" class="save-state" role="status"></span>
    <button type="button" id="deck-save" class="button-icon icon-ghost header-save" hidden
            data-tip="<%= t('header.save') %>" aria-label="<%= t('header.save') %>"></button>
  </div>
    </details>
  </div>

  <!-- Presenting is what the whole editor is for, so it is the one filled
       button on the page and it says its word rather than hiding behind a
       triangle. A header full of same-sized grey squares has no answer to
       "and now what?"; this one does.

       It is two things: from the top, or from wherever the editor stands.
       On the first slide those two are the same thing, so there the button
       stays the plain link it always was and the menu keeps out of the way
       -- a choice between one thing is a click for nothing. index.js swaps
       the two as the slide changes and writes the address of the current
       slide into the second entry. -->
  <a class="button button-haupt header-present present-direct" data-tip="<%= t('header.presentKey') %>"
     href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"><span
     class="present-mark" aria-hidden="true"></span><%= t('header.present') %></a>
  <details class="menu present-menu" hidden>
    <summary class="button button-haupt header-present" data-tip="<%= t('header.presentKey') %>"><span
             class="present-mark" aria-hidden="true"></span><%= t('header.present') %></summary>
    <div class="menu-content" role="menu">
      <a class="menu-item present-from-start" role="menuitem"
         href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"><span
         class="menu-item-icon" aria-hidden="true"></span><%= t('header.presentFromStart') %></a>
      <a id="present-from-current" class="menu-item present-from-current" role="menuitem"
         href="<%= BASE %>/d/<%= slug %>/present" target="_blank" rel="noopener"><span
         class="menu-item-icon" aria-hidden="true"></span><%= t('header.presentFromCurrent') %></a>
    </div>
  </details>

  <%- include("partials/settings") %>
</header>

<main class="editor">

  <!-- Left: the slides as a list. Reorder by dragging.

       The list scrolls by its two buttons rather than by a bar beside it
       (js/slide-list-scroll.js). They are only there when there is more
       list than room, and because only the list itself scrolls now, the
       word above it and the button under it stay where they are -- which
       is what one wants of the button that adds a slide: it used to be at
       the end of a column thirty cards long. -->
  <aside class="column slide-list">
    <span class="columns-head"><%= t('column.slides') %></span>
    <button type="button" class="slides-step" data-dir="up" hidden
            aria-controls="slide-list" aria-label="<%= t('editor.slidesUp') %>"
            data-tip="<%= t('editor.slidesUp') %>"></button>
    <ol id="slide-list" class="slides"></ol>
    <button type="button" class="slides-step" data-dir="down" hidden
            aria-controls="slide-list" aria-label="<%= t('editor.slidesDown') %>"
            data-tip="<%= t('editor.slidesDown') %>"></button>
    <button id="slide-new" class="button button-wide" type="button"><%= t('editor.slideNew') %></button>
  </aside>

  <!-- Middle: the form for the selected slide. Nowhere here is there any
       Markdown syntax -- that is the whole point of the exercise. -->
  <section id="slide-form" class="column form">
    <!-- What the slide is BUILT of. Three questions, and the first of them
         used to take a third of the column: eleven tiles standing open all
         day for a choice one makes once per slide and then lives with.

         So the tiles moved into a sheet behind the thing they decide. What
         stands here is the ANSWER -- the picture of the layout in force and
         its name -- and pressing it opens the eleven at the size they need
         to be read at. The form got some 180 pixels back, and they went to
         the text field, which is what one actually spends the day in. -->
    <fieldset class="fieldset shape-box">
      <legend><%= t('editor.structure') %></legend>

      <details id="layout-menu" class="menu layout-menu">
        <summary id="layout-current" class="layout-current"
                 aria-label="<%= t('editor.structure') %>">
          <span id="layout-current-mini" class="mini" aria-hidden="true"></span>
          <span id="layout-current-name" class="layout-current-name"></span>
          <span class="layout-current-change"><%= t('editor.layoutChange') %></span>
        </summary>
        <div class="menu-content layout-sheet" role="menu"
             aria-label="<%= t('editor.structure') %>">
          <div id="layout-tiles" class="layout-tiles">
            <% layouts.forEach(function (l) { %>
              <button type="button" class="layout-tile" role="menuitemradio"
                      aria-checked="false" data-layout="<%= l.id %>" data-tip="<%= l.hint %>">
                <span class="mini mini-<%= l.id %>" aria-hidden="true"></span>
                <span class="layout-name"><%= l.label %></span>
              </button>
            <% }); %>
          </div>
          <!-- Why the tiles are dead on a slide that already says something.
               A disabled button has no tooltip to explain itself with, so the
               reason stands here (js/editor/index.js). It is in the sheet
               rather than in the form because that is where the dead tiles
               are: an explanation of something one cannot see is noise. -->
          <p id="layout-locked" class="hint" hidden><%= t('editor.layoutLocked') %></p>
        </div>
      </details>
      <p id="layout-hint" class="hint"></p>

      <!-- How many columns the text runs in, and how they are filled. The
           two belong next to each other, because one asks how many columns
           there are and the other how they are filled -- and both are
           questions about the SHAPE of the slide, which is why they are
           here and not in the text bar.

           They sit outside the sheet above because they are not a layout:
           the tiles are dead as soon as the slide has text on it
           (js/editor/index.js), and the number has to stay changeable --
           that is the whole reason it is a field. -->
      <div id="field-column-count" class="field-column-count" role="group" hidden
           aria-label="<%= t('editor.columnCount') %>"
           data-tip="<%= t('editor.columnCountHint') %>">
        <span class="field-label"><%= t('editor.columnCount') %></span>
        <div class="count-choice">
          <% columnCounts.forEach(function (n) { %>
            <button type="button" class="count-option" data-count="<%= n %>"
                    aria-pressed="false"><%= n %></button>
          <% }); %>
        </div>
      </div>

      <!-- Off (and that is how every deck written so far reads) the slide
           has one text and the browser distributes it. Only there once the
           slide stands in more than one column. -->
      <label class="field field-columns" hidden
             data-tip="<%= t('editor.columnsSplitHint') %>">
        <input type="checkbox" id="slide-columns-split" class="switch">
        <span><%= t('editor.columnsSplit') %></span>
      </label>

      <!-- Whether this one slide shows the deck's two strips. Here, with
           the layout, and not among the colours: a band takes a line off
           the top and the bottom of the slide, which is a question about
           what the slide is built of.

           Each switch is only there while the deck HAS that band -- a
           switch for something that does not exist would be a promise the
           slide cannot keep (js/editor/index.js). Worded the positive way
           round, "show it", although the file says the opposite
           (data-no-header): what a reader wants to know standing in front
           of the slide is whether the line is on it. -->
      <div id="slide-bands" class="slide-bands" hidden>
        <span class="field-label"><%= t('editor.bandsOn') %></span>
        <label class="switch-line" data-band="header" hidden>
          <input type="checkbox" id="slide-header-on" class="switch">
          <span><%= t('editor.noHeader') %></span>
        </label>
        <label class="switch-line" data-band="footer" hidden>
          <input type="checkbox" id="slide-footer-on" class="switch">
          <span><%= t('editor.noFooter') %></span>
        </label>
        <p class="hint"><%= t('editor.bandsHint') %></p>
      </div>
    </fieldset>

    <!-- What the slide SAYS, what it LOOKS like, and what the deck has in
         its folder -- three tabs over one box. Two boxes under each other
         is what the first two were, with the second
         folded away because it is reached for later -- and a box that is
         sometimes there and sometimes not is a different form every time
         one opens it. Tabs say the same thing without moving anything: one
         of the two is in front, both are always a click away, and the form
         below the chooser is always the same height.

         The chooser is a strip along the top of the box rather than a line
         of labels floating above it (app.css). It is the one piece of
         furniture in this column that has to be NOTICED -- half the form
         is behind it -- and the small grey capitals the other boxes wear
         are made to be read once and then ignored. -->
    <div class="tabbed">
      <div class="tab-row" role="tablist" aria-label="<%= t('editor.tabs') %>">
        <button type="button" class="tab" id="tab-content" role="tab"
                aria-controls="panel-content" aria-selected="true"
                data-panel="panel-content"><%= t('editor.content') %></button>
        <button type="button" class="tab" id="tab-colors" role="tab"
                aria-controls="panel-colors" aria-selected="false" tabindex="-1"
                data-panel="panel-colors"><%= t('editor.colorsTab') %></button>
        <!-- The third one is about the DECK and not about the slide in
             front: every picture the folder holds, and which slides stand
             on it. It sits here all the same, because this is where one is
             when the question comes up -- a picture is chosen on a slide,
             and the question of what else is lying about is one slide
             later. -->
        <button type="button" class="tab" id="tab-library" role="tab"
                aria-controls="panel-library" aria-selected="false" tabindex="-1"
                data-panel="panel-library"><%= t('editor.libraryTab') %></button>
      </div>

      <div id="panel-content" class="tab-panel" role="tabpanel"
           aria-labelledby="tab-content">

        <!-- No longer a <label> around the whole thing: a click on the
             chooser beside the field would otherwise land in the field,
             which is what a label does. The word keeps its "for" instead. -->
        <!-- The id is what the one layout WITHOUT a heading hides
             (js/editor/index.js): there a heading is not the slide's name
             but one of the blocks in its text. -->
        <div class="field" id="field-heading">
          <label class="field-label" for="slide-title"><%= t('editor.heading') %></label>
          <div class="field-row">
            <input id="slide-title" maxlength="200" placeholder="<%= t('editor.headingPlaceholder') %>">
            <!-- Where the heading stands on the slide. It sits INSIDE the
                 field's box (the row carries the border and the focus ring,
                 app.css), so the two read as one control. The button wears
                 the icon of the alignment in force -- also while the slide
                 has made no choice and the layout decides, because what one
                 wants to see here is where the heading IS. Which of the four
                 is chosen is marked in the menu (js/editor/index.js). -->
            <details id="title-align-menu" class="menu title-align"
                     data-name="<%= t('editor.titleAlign') %>">
              <summary id="title-align-button" class="button-icon tool-align"
                       data-align="left" data-choice=""
                       aria-label="<%= t('editor.titleAlign') %>"></summary>
              <div class="menu-content" role="menu">
                <button type="button" class="menu-item tool-align" role="menuitemradio"
                        aria-checked="false" data-align=""><span
                        class="menu-item-icon" aria-hidden="true"></span><%= t('titleAlign.default') %></button>
                <% ["left", "center", "right"].forEach(function (a) { %>
                  <button type="button" class="menu-item tool-align" role="menuitemradio"
                          aria-checked="false" data-align="<%= a %>"><span
                          class="menu-item-icon" aria-hidden="true"></span><%= t('titleAlign.' + a) %></button>
                <% }); %>
              </div>
            </details>
          </div>
        </div>

        <!-- What a freestyle slide is written with instead of one text
             field. There the slide is not one text but several, each
             standing somewhere of its own -- and a single box holding all
             of them, comment lines and all, was the one thing that made
             the layout unreadable to work with.

             So: the list of them. Every element the slide carries has a
             row of its own -- what it says, what kind of thing it is, and
             the two buttons that copy it and take it away -- and the row
             opens into the element's own editor, right here in the form.
             The preview keeps its half of the work: a row is opened from
             over there too, by the pencil or by two clicks on the thing
             itself (js/slide-place.js).

             The list and the rows are built in the page, because what is
             in them is the slide's own text (js/editor/index.js). -->
        <div class="field" id="freestyle-tools" hidden>
          <div class="place-head">
            <span class="field-label" id="place-list-label"><%= t('editor.placeElements') %></span>
            <span class="place-count" id="place-count"></span>
          </div>
          <ul class="place-list" id="place-list" aria-labelledby="place-list-label"></ul>
          <p class="hint place-empty" id="place-empty" hidden><%= t('editor.placeEmpty') %></p>
          <!-- What the order of these rows MEANS, said where the two arrows
               that change it are. On a freestyle slide the blocks are drawn
               in the order they stand in the file, so the last of them is
               the one on top -- and that is not something anybody guesses
               from a list. -->
          <p class="hint place-order" id="place-order" hidden><%= t('editor.placeOrder') %></p>

          <!-- Two buttons, for the two things an element can be. The SIZE
               is not asked here: it is asked in the row that opens with
               the new element, where it has to be asked anyway because a
               size can be changed afterwards. Four buttons for four sizes
               made the form ask the same question twice.

               A picture is not asked anything. It is chosen in the
               picker, lands on the slide and is then a thing for the
               mouse -- there is nothing to type about it.

               Words on them and not bare icons: this is the one thing on
               this panel that a slide with nothing on it needs, and two
               16px glyphs in a corner were the smallest thing in the
               column saying the most important sentence in it. -->
          <span class="field-label place-add-label"><%= t('editor.placeNew') %></span>
          <div class="place-add">
            <button type="button" class="button place-add-button"><%= t('editor.placeAdd') %></button>
            <button type="button" class="button place-add-image"><%= t('editor.placeAddImage') %></button>
          </div>
          <p class="hint"><%= t('editor.placeHint') %></p>
        </div>

        <!-- One element's editor, cloned into the row that is open. Its
             fields are the ones a single block can be given: how large it
             is, what it says, and whether it waits for a click. Nothing
             here is an id -- the thing is stamped out per element, and a
             form full of twins may not have two of the same name
             (js/editor/index.js).

             What is NOT here is Apply. The row writes into the slide as
             one types, exactly as the text field of every other layout
             does, and the preview beside it shows the result -- so there
             is nothing left for a button to confirm. -->
        <template id="element-editor">
          <div class="place-editor">
            <!-- Only for a block that HAS a size to choose: a list, a code
                 block or a picture keeps its text and is not asked how
                 large it is (js/editor/places.js, read). -->
            <div class="field element-level-field">
              <span class="field-label"><%= t('dialog.elementLevel') %></span>
              <!-- Icons and not words: the four words are longer than what
                   they name, and the bar under this one asks its questions
                   the same way. Each one keeps its word where a word is
                   still needed -- in the tooltip and on the button's name
                   for a screen reader. -->
              <div class="count-choice element-level" role="group"
                   aria-label="<%= t('dialog.elementLevel') %>">
                <% ["1", "2", "3", "0"].forEach(function (n) { %>
                  <button type="button" class="count-option" data-level="<%= n %>"
                          data-tip="<%= t('editor.placeAdd' + n) %>"
                          aria-label="<%= t('editor.placeAdd' + n) %>"
                          aria-pressed="false"></button>
                <% }); %>
              </div>
            </div>

            <div class="field element-field">
              <span class="field-label"><%= t('dialog.elementText') %></span>
              <!-- The same bar as over the slide's text field, with what
                   makes sense for ONE block on it. What is missing is
                   missing on purpose: the slide-wide things (a text
                   waiting for a click is asked below, where it belongs to
                   the element) and the ones that need a field this row
                   does not have.

                   The four alignments are NOT text commands here. On a
                   placed element the alignment belongs to the element, so
                   it rides on the element's own comment line beside its
                   place (js/editor/places.js) -- one line that says
                   everything about this one block. -->
              <div class="toolbar element-toolbar" role="toolbar"
                   aria-label="<%= t('editor.toolbar') %>">
                <% [["bold", "boldTip", "bold"], ["italic", "italicTip", "italic"],
                    ["strikeThrough", "strikethrough", "strikethrough"],
                    ["insertUnorderedList", "bulletList", "bulletList"],
                    ["insertOrderedList", "numberedList", "numberedList"],
                    ["link", "link", "link"]].forEach(function (b) { %>
                  <button type="button" class="tool-icon" data-command="<%= b[0] %>"
                          data-tip="<%= t('tool.' + b[1]) %>" aria-label="<%= t('tool.' + b[2]) %>"></button>
                <% }); %>
                <span class="toolbar-divider"></span>
                <% [["left", "alignLeft"], ["center", "alignCenter"], ["right", "alignRight"], ["fill", "alignFill"]].forEach(function (a) { %>
                  <button type="button" class="tool-icon" data-align="<%= a[0] %>"
                          data-tip="<%= t('tool.' + a[1]) %>" aria-label="<%= t('tool.' + a[1]) %>"></button>
                <% }); %>
                <span class="toolbar-divider"></span>
                <!-- The three that put something IN rather than format what
                     is there: a colour on a few words, a block of code, a
                     character. The same three the slide's own bar carries,
                     acting on this row's field instead -- they ask where
                     they stand rather than knowing it (js/editor/index.js,
                     writtenIn).

                     They were missing here, and for no reason anybody could
                     name: this bar was built as the short version of that
                     one, and the three that are not execCommand simply did
                     not get copied. An element is as much a text as a slide
                     is; on a freestyle slide it is the ONLY text, because
                     the slide's own field is not there at all. -->
                <span class="tool-color" data-tip="<%= t('tool.colorTip') %>">
                  <input class="color-field element-color" type="text" value=""
                         aria-label="<%= t('tool.color') %>">
                </span>
                <button type="button" class="tool-icon tool-code element-code"
                        data-tip="<%= t('tool.codeTip') %>" aria-label="<%= t('tool.code') %>"></button>
                <!-- The panel is the same 450 keys the slide's bar offers,
                     copied in the first time this one is opened: written
                     out per row they would be 30 kB of markup for something
                     most rows never ask for. -->
                <details class="menu menu-tool emoji-menu element-emoji" data-keep-open>
                  <summary class="tool-icon tool-emoji" data-tip="<%= t('tool.emojiTip') %>"
                           aria-label="<%= t('tool.emoji') %>"></summary>
                  <div class="menu-content emoji-panel" role="menu">
                    <div class="emoji-grid"></div>
                  </div>
                </details>
              </div>
              <div class="field-frame element-frame">
                <div class="content-field element-content" contenteditable="true" spellcheck="true"
                     role="textbox" aria-multiline="true"
                     aria-label="<%= t('dialog.elementText') %>"></div>
              </div>
              <div class="field-frame element-source" hidden>
                <textarea class="source-field element-text" spellcheck="false"
                          aria-label="<%= t('dialog.elementText') %>"></textarea>
              </div>
              <p class="hint element-source-note" hidden><%= t('dialog.elementSource') %></p>
            </div>

            <!-- A picture instead of the line that describes it. Same row
                 as the picture of a layout that has one (field-image
                 above): the picture itself, and the one button there is
                 anything to say about it with. The field above and this
                 one take each other's place -- an element is words or it
                 is a picture (js/editor/index.js, showElementText).

                 No button to remove it here. An element with nothing in it
                 is no element, so removing the picture IS removing the
                 element, and the row's own bin says that plainly. -->
            <div class="field element-image-field" hidden>
              <span class="field-label"><%= t('editor.image') %></span>
              <div class="image-row">
                <img class="image-preview element-image-preview" alt="">
                <div class="image-buttons">
                  <button type="button" class="button element-image-choose"><%= t('editor.imageChoose') %></button>
                </div>
              </div>
            </div>

            <!-- A property of the element, like its place: this one block
                 waits for a click while the rest of the slide is already
                 standing. -->
            <label class="field field-schmal code-fragment-line">
              <input type="checkbox" class="switch element-fragment">
              <span><%= t('dialog.elementFragment') %></span>
            </label>
            <p class="hint element-note"><%= t('dialog.elementNote') %></p>
            <p class="hint element-image-note" hidden><%= t('dialog.elementImageNote') %></p>
          </div>
        </template>

        <div class="field" id="field-text">
          <span class="field-label" id="text-label"><%= t('editor.text') %></span>
          <!-- Which column the field below shows. They stand where the label
               stands and take its place, because "Text" and "Column 2" are
               the same line of the form -- and one field with a chooser over
               it keeps the bar, the code dialog and the whole field height
               for whichever column is being written (js/editor/index.js).
               Three is the most any layout has; which of them are shown
               follows the layout. -->
          <div class="column-tabs" id="column-tabs" role="tablist" hidden>
            <% [1, 2, 3].forEach(function (n) { %>
              <button type="button" class="column-tab" role="tab" data-column="<%= n %>"
                      aria-selected="false"><%= t('editor.column', { n: n }) %></button>
            <% }); %>
          </div>
          <div class="toolbar" id="text-toolbar" role="toolbar" aria-label="<%= t('editor.toolbar') %>">
            <div class="toolbar-group">
            <button type="button" class="tool-icon" data-command="bold" data-tip="<%= t('tool.boldTip') %>" aria-label="<%= t('tool.bold') %>"></button>
            <button type="button" class="tool-icon" data-command="italic" data-tip="<%= t('tool.italicTip') %>" aria-label="<%= t('tool.italic') %>"></button>
            <button type="button" class="tool-icon" data-command="strikeThrough" data-tip="<%= t('tool.strikethrough') %>" aria-label="<%= t('tool.strikethrough') %>"></button>
            </div>
            <div class="toolbar-group">
            <button type="button" class="tool-icon" data-command="insertUnorderedList" data-tip="<%= t('tool.bulletList') %>" aria-label="<%= t('tool.bulletList') %>"></button>
            <button type="button" class="tool-icon" data-command="insertOrderedList" data-tip="<%= t('tool.numberedList') %>" aria-label="<%= t('tool.numberedList') %>"></button>
            <!-- A quote. In this group because it is the third thing one
                 does to a LINE rather than to a word, and because it is
                 the same kind of press as the two beside it: it takes the
                 paragraph the cursor is in, or every one the selection
                 touches, and pressing it again takes it back.

                 It is also what makes the quote LAYOUT workable. That
                 layout wraps the body in a blockquote of its own
                 (render.js), so a quote written with > used to be said
                 twice and shown by the field not at all -- the slide was
                 stuck in source mode over markup the layout had put
                 there in spirit (js/editor/richtext.js). -->
            <!-- A heading INSIDE the text, which is not the heading field
                 above: that one names the slide, this one names the second
                 half of it. The renderer has always carried them --
                 slides.css even spans one across the columns of a split
                 slide -- and the freestyle elements have offered the same
                 four levels from the start. Only this field could not show
                 one, which sent every slide with a ## in its body to
                 source mode (js/editor/richtext.js).

                 A menu and not four buttons: four would be a quarter of
                 this bar again, and the four are a CHOICE -- a block is
                 one of them at a time, which is what a menu of radio rows
                 says and a row of toggles does not. The words are the
                 ones the freestyle element editor already uses; a second
                 set of names for the same four things would be the
                 mistake. -->
            <details id="level-menu" class="menu menu-tool"
                     data-name="<%= t('tool.level') %>">
              <summary id="level-button" class="tool-icon tool-level"
                       data-tip="<%= t('tool.levelTip') %>"
                       aria-label="<%= t('tool.level') %>"></summary>
              <div class="menu-content" role="menu">
                <% ["1", "2", "3", "0"].forEach(function (n) { %>
                  <button type="button" class="menu-item tool-level-row" role="menuitemradio"
                          aria-checked="false" data-level="<%= n %>"><span
                          class="menu-item-icon" aria-hidden="true"></span><%= t('editor.placeAdd' + n) %></button>
                <% }); %>
              </div>
            </details>
            <button type="button" class="tool-icon" data-command="quote" data-tip="<%= t('tool.quoteTip') %>" aria-label="<%= t('tool.quote') %>"></button>
            <button type="button" class="tool-icon" data-command="link" data-tip="<%= t('tool.link') %>" aria-label="<%= t('tool.link') %>"></button>
            </div>
            <div class="toolbar-group">
            <!-- Where the text stands. Unlike the two menus further along
                 this bar, these are NOT slide-wide: they mark the paragraph
                 the cursor is in, or every one the selection touches. The
                 mark travels in the .md as the class of an .element comment
                 -- the same line the fragment above rides on, so a centred
                 bullet that appears on click is one comment with two
                 classes (js/editor/richtext.js). -->
            <% [["left", "alignLeft"], ["center", "alignCenter"], ["right", "alignRight"], ["fill", "alignFill"]].forEach(function (a) { %>
              <button type="button" class="tool-icon" data-command="align-<%= a[0] %>"
                      data-tip="<%= t('tool.' + a[1]) %> — <%= t('tool.alignTip') %>"
                      aria-label="<%= t('tool.' + a[1]) %>"></button>
            <% }); %>
            </div>
            <div class="toolbar-group">
            <!-- Colour for a few words. Not a button but a field, because the
                 picker is the one the colour choices further down use and it
                 hangs itself on a field (js/editor/index.js). Coloris wraps
                 it, paints its wrapper in the chosen colour, and that is what
                 tints the drop on the button -- the icon wears the colour it
                 would apply, without anyone having to write it there.
                 The field carries the value; the drop and the invisible input
                 over it are drawn by app.css. -->
            <span class="tool-color" data-tip="<%= t('tool.colorTip') %>">
              <input id="text-color-tool" class="color-field" type="text" value=""
                     aria-label="<%= t('tool.color') %>">
            </span>
            </div>
            <div class="toolbar-group">
            <!-- "Reveal on a click", and the question is WHAT. One block of
                 the text says so for itself, with a class of its own in the
                 .md; the box around the whole text cannot -- the renderer
                 builds that box and the file has no line pointing at it, so
                 the SLIDE says it (render.js, deck.js). Two different
                 things behind one icon, which is why the icon opens a menu
                 rather than toggling.

                 Two checkmarks and not two sides of a choice: a slide may
                 have both, a text that waits for a click and a block
                 inside it that waits for a second one. -->
            <details id="fragment-menu" class="menu menu-tool"
                     data-name="<%= t('tool.fragment') %>">
              <summary id="fragment-button" class="tool-icon tool-fragment"
                       data-tip="<%= t('tool.fragmentTip') %>"
                       aria-label="<%= t('tool.fragment') %>"></summary>
              <div class="menu-content" role="menu">
                <button type="button" class="menu-item" role="menuitemcheckbox"
                        aria-checked="false" data-fragment="block"><span
                        class="menu-item-icon" aria-hidden="true"></span><%= t('tool.fragmentBlock') %></button>
                <button type="button" class="menu-item" role="menuitemcheckbox"
                        aria-checked="false" data-fragment="text"><span
                        class="menu-item-icon" aria-hidden="true"></span><%= t('tool.fragmentText') %></button>
                <!-- The third: several blocks on ONE click. Not a thing of
                     its own in the markup but a NUMBER on each of them --
                     reveal.js shows every fragment carrying the same
                     data-fragment-index together (js/editor/richtext.js,
                     render.js). Which is also the only thing that reaches
                     into a list: two of four bullets cannot be wrapped in
                     anything without becoming a second list. -->
                <button type="button" class="menu-item" role="menuitemcheckbox"
                        aria-checked="false" data-fragment="together"><span
                        class="menu-item-icon" aria-hidden="true"></span><%= t('tool.fragmentGroup') %></button>
              </div>
            </details>
            <!-- Code is the one thing in this bar that the rich-text field
                 cannot hold, so it does not run through execCommand and it
                 stays usable in source mode -- that is where it lands. -->
            <button type="button" id="code-insert" class="tool-icon tool-code" data-tip="<%= t('tool.codeTip') %>" aria-label="<%= t('tool.code') %>"></button>
            <!-- Emoji. Like the code button this is not a formatting command
                 but something inserted, so it keeps working in source mode --
                 there the character goes into the textarea at the cursor.
                 A handful and not all of Unicode (emoji.js); the system's own
                 picker is still there for the rest and still works in the
                 field. -->
            <details id="emoji-menu" class="menu menu-tool emoji-menu" data-keep-open>
              <summary class="tool-icon tool-emoji" data-tip="<%= t('tool.emojiTip') %>"
                       aria-label="<%= t('tool.emoji') %>"></summary>
              <!-- Filled by the page from the table at the end of this file:
                   450 buttons written out here would be 30 kB of markup for
                   something most of which is never looked at. -->
              <div class="menu-content emoji-panel" role="menu">
                <div id="emoji-grid" class="emoji-grid"></div>
              </div>
            </details>
            </div>
            <div class="toolbar-group">
            <!-- Where the text sits in relation to the player, on a video
                 slide. In the bar it is the icon of the side in force and
                 nothing else; the words are in the menu, where there is room
                 for them. Like the code button it is not a rich-text command,
                 so it keeps working in source mode.

                 Two words per entry, for the same reason the width button
                 below carries two names: the thing the text stands beside is
                 a player on a video slide and a code on a QR one. Both
                 travel with the entry and the page puts the fitting one in
                 (js/editor/index.js). -->
            <details id="text-side-menu" class="menu menu-tool"
                     data-name="<%= t('editor.textSide') %>" hidden>
              <summary id="text-side-button" class="tool-icon tool-side" data-side="oben"
                       aria-label="<%= t('editor.textSide') %>"></summary>
              <div class="menu-content" role="menu">
                <% textSides.forEach(function (s) { %>
                  <button type="button" class="menu-item tool-side" role="menuitemradio"
                          aria-checked="false" data-side="<%= s.id %>"
                          data-name-video="<%= s.nameVideo %>"
                          data-name-qr="<%= s.nameQr %>"><span
                          class="menu-item-icon" aria-hidden="true"></span><span
                          class="menu-item-text"><%= s.nameVideo %></span></button>
                <% }); %>
              </div>
            </details>
            <!-- Where the text box stands on a full-bleed picture. The menu
               is a small map of the slide: nine cells, and the one that is
               pressed is the place the box takes. A list of nine words
               would say the same thing and be read nine times slower --
               here the position of the button IS the information, the way
               the ratios in the preview chooser are. Which of the nine is
               in force is marked in the menu; the button in the bar wears
               its icon and nothing else. -->
          <details id="text-place-menu" class="menu menu-tool" hidden
                   data-name="<%= t('editor.textPlace') %>">
            <summary id="text-place-button" class="tool-icon tool-place" data-place="center"
                     aria-label="<%= t('editor.textPlace') %>"></summary>
            <div class="menu-content menu-grid" role="menu"
                 aria-label="<%= t('editor.textPlace') %>">
              <% places.forEach(function (pl) { %>
                <button type="button" class="place-cell" role="menuitemradio"
                        aria-checked="false" data-place="<%= pl.id %>"
                        data-tip="<%= pl.name %>" aria-label="<%= pl.name %>"></button>
              <% }); %>
            </div>
          </details>
          <!-- How wide the text may get beside the player. A percentage
                 says itself, so this one wears its value rather than an icon
                 -- and it is switched off, not hidden, while the text is
                 above or below the player: there it has the full width and
                 the number would be a promise the slide does not keep. -->
            <!-- Two names, because the thing the text stands beside differs by
                 layout: a picture on image-left/-right, a player on video.
                 Both travel with the button and the page picks the fitting
                 one (js/editor/index.js) -- naming it after the layout on the
                 server would mean re-rendering the bar on every layout
                 change. -->
            <details id="text-width-menu" class="menu menu-tool" hidden
                     data-name-image="<%= t('editor.textWidthImage') %>"
                     data-name-video="<%= t('editor.textWidthVideo') %>"
                     data-name-qr="<%= t('editor.textWidthQr') %>">
              <summary id="text-width-button" class="tool-word"></summary>
              <div class="menu-content" role="menu">
                <% textWidths.forEach(function (b) { %>
                  <button type="button" class="menu-item" role="menuitemradio"
                          aria-checked="false" data-width="<%= b %>"><%= b %>&nbsp;%</button>
                <% }); %>
              </div>
            </details>
            </div>
            <div class="toolbar-group toolbar-end">
            <button type="button" id="source-toggle" class="tool-icon" data-tip="<%= t('tool.sourceTip') %>" aria-label="<%= t('tool.source') %>"></button>
          </div>
          </div>
          <!-- The frame, not the field, is what scrolls: OverlayScrollbars
               builds its own DOM inside whatever it is attached to, and the
               editor reads the content field's innerHTML back as Markdown. -->
          <div id="content-frame" class="field-frame">
            <div id="slide-content" class="content-field" contenteditable="true" spellcheck="true"
                 data-placeholder="<%= t('editor.textPlaceholder') %>"></div>
          </div>
          <div id="source-frame" class="field-frame" hidden>
            <textarea id="slide-source-text" class="source-field" spellcheck="false"></textarea>
          </div>
          <p id="source-note" class="hint" hidden>
            <%= t('editor.sourceNote') %>
          </p>
        </div>

        <div class="field field-image" hidden>
          <span class="field-label"><%= t('editor.image') %></span>
          <div class="image-row">
            <img id="image-preview" class="image-preview" alt="" hidden>
            <div class="image-buttons">
              <button type="button" id="image-choose" class="button"><%= t('editor.imageChoose') %></button>
              <button type="button" id="image-remove" class="button button-quiet" hidden><%= t('editor.imageRemove') %></button>
            </div>
          </div>
        </div>

        <!-- The link as it sits in the clipboard; what lands in the file is
             the id inside it (video.js). The pattern is the server's, so the
             page recognises a link the same way the server does. -->
        <label class="field field-video" hidden>
          <span class="field-label"><%= t('editor.video') %></span>
          <input id="slide-video" type="text" maxlength="200" spellcheck="false"
                 placeholder="<%= t('editor.videoPlaceholder') %>"
                 data-pattern="<%= videoPattern %>">
          <span id="video-note" class="hint"></span>
        </label>

        <!-- The address the code points at. Same shape as the video field:
             whatever is pasted goes to the server as it stands, and the
             server decides what a usable address is (qr.js). -->
        <label class="field field-url" hidden>
          <span class="field-label"><%= t('editor.url') %></span>
          <input id="slide-url" type="text" maxlength="300" spellcheck="false"
                 placeholder="<%= t('editor.urlPlaceholder') %>">
          <span id="url-note" class="hint"></span>
        </label>

        <!-- The code's own colours. Here with the code's address and not on
             the colour tab, because the colours over there belong to the
             SLIDE and these to the one picture on it -- and because that is
             where somebody who has just typed the address is looking.
             Clearing the background is what makes it see-through. -->
        <div class="field field-qr-colors" hidden>
          <span class="field-label"><%= t('editor.qrColors') %></span>
          <div class="color-row">
            <label class="color-choice">
              <span class="field-label"><%= t('editor.qrColor') %></span>
              <input id="qr-color" class="color-field" type="text" value="" aria-label="<%= t('editor.qrColor') %>">
            </label>
            <label class="color-choice">
              <span class="field-label"><%= t('editor.qrBackground') %></span>
              <input id="qr-background" class="color-field" type="text" value="" aria-label="<%= t('editor.qrBackground') %>">
            </label>
            <label class="color-choice">
              <span class="field-label"><%= t('editor.qrTextColor') %></span>
              <input id="qr-text-color" class="color-field" type="text" value="" aria-label="<%= t('editor.qrTextColor') %>">
            </label>
          </div>
          <p class="hint"><%= t('editor.qrColorsHint') %></p>
        </div>

        <label class="field field-source" hidden>
          <span class="field-label"><%= t('editor.source') %></span>
          <input id="slide-source" maxlength="200" placeholder="<%= t('editor.sourcePlaceholder') %>">
        </label>
      </div>

      <div id="panel-colors" class="tab-panel" role="tabpanel"
           aria-labelledby="tab-colors" hidden>
        <!-- THE RESULT FIRST, then the three things that make it.
             Colour, gradient and effect do not stand side by side on the
             slide: they stack, the ground first and each of the others
             over it (render.js). Shown as three rows and nothing else,
             the panel asked three questions and never answered the one
             anybody actually has -- what does that look like together.

             And under the sample the one question the panel used to let
             a person walk away from: whether the writing can be read on
             it. The two colours are chosen minutes apart on this very
             panel and nothing had ever put them side by side
             (js/editor/contrast.js). -->
        <div class="look-sample-field">
          <div id="look-sample" class="look-sample">
            <span class="look-sample-title"><%= t('editor.sampleTitle') %></span>
            <span class="look-sample-text"><%= t('editor.sampleText') %></span>
          </div>
          <p id="look-contrast" class="look-contrast" role="status"></p>
        </div>

        <!-- Two things a slide can be given its own way, and they are not
             the same kind of thing: the writing takes a colour and nothing
             else, the ground takes a colour AND a gradient over it AND an
             effect over that. One heading each, so that the three layers
             of a background read as three parts of ONE thing rather than
             as three settings standing side by side. -->
        <!-- No heading over this one. It is a single row, and a heading
             that names the same thing as the label under it is the label
             said twice: the panel used to read TEXT / Farbe for one
             swatch. The ground below keeps its heading because it really
             does gather three rows. -->
        <div class="look-row">
          <label class="color-choice">
            <span class="look-row-label"><%= t('editor.textColorRow') %></span>
            <input id="text-color-custom" class="color-field" type="text" value="" aria-label="<%= t('editor.textColor') %>">
          </label>
          <!-- What is set, in words. Every row on this panel ends in one:
               a swatch says what a colour LOOKS like and a tile says what
               a gradient looks like, neither says which it is, and the
               only place the name used to live was a tooltip -- which a
               finger never sees. -->
          <span id="text-color-name" class="look-row-value"></span>
        </div>

        <div class="color-group">
          <span class="group-label"><%= t('editor.background') %></span>

          <div class="look-row">
            <label class="color-choice">
              <span class="look-row-label"><%= t('editor.backgroundBase') %></span>
              <input id="background-custom" class="color-field" type="text" value="" aria-label="<%= t('editor.background') %>">
            </label>
            <span id="background-color-name" class="look-row-value"></span>
          </div>

          <!-- The gradient, and it lies OVER the colour above -- which the
               row says in its own label now rather than in a sentence
               underneath.

               A radiogroup and not a row of buttons: one of these is in
               force at a time, which is what a radio says and a button
               does not. Before this they were plain buttons in a plain
               group, so the chosen one was a CSS class and nothing else --
               a screen reader could not tell which gradient a slide had,
               and crossing the two rows cost thirteen presses of Tab. Now
               each row is one stop and the arrow keys move inside it, the
               same as the tabs over this panel.

               The swatches come from gradients.js, which a deck collection
               extends through decks/gradients.json -- so this row is as
               long as someone made it, not eight items by design. Each
               swatch wears its own gradient, which is why the value is in
               the style attribute: a stylesheet cannot know them. -->
          <div class="field field-gradient">
            <div class="look-row look-row-wide">
              <span class="look-row-label" id="gradient-label"><%= t('editor.gradientOver') %></span>
              <span id="gradient-name" class="look-row-value"></span>
            </div>
            <div id="gradient-presets" class="gradient-presets" role="radiogroup"
                 aria-labelledby="gradient-label">
              <button type="button" class="gradient-probe swatch-none" role="radio"
                      aria-checked="false" tabindex="0" data-gradient=""
                      data-tip="<%= t('editor.gradientNone') %>" aria-label="<%= t('editor.gradientNone') %>"></button>
              <% gradients.forEach(function (v) { %>
                <button type="button" class="gradient-probe" role="radio"
                        aria-checked="false" tabindex="-1" data-gradient="<%= v.css %>"
                        style="background-image: <%= v.css %>"
                        data-tip="<%= v.name %>" aria-label="<%= v.name %>"></button>
              <% }); %>
            </div>
            <!-- Written CSS, behind a fold. It is the one place in this
                 whole form where somebody is asked to type a language,
                 and the editor's premise is that nobody has to -- so it
                 stops being the first thing under the swatches and
                 becomes the thing one opens on purpose. Open it stays, for
                 as long as the editor is: somebody who writes one gradient
                 writes several. -->
            <details id="gradient-own" class="look-own">
              <summary><%= t('editor.gradientCustom') %></summary>
              <input id="slide-gradient" class="gradient-field" type="text" spellcheck="false"
                     maxlength="<%= gradientMax %>" pattern="<%= gradientPattern %>"
                     placeholder="<%= t('editor.gradientPlaceholder') %>" aria-label="<%= t('editor.gradientCustom') %>">
              <p id="gradient-hint" class="hint"><%= t('editor.gradientNote') %></p>
            </details>
          </div>

          <!-- Animated backgrounds, over both of the above. A name, not a
               value -- what it looks like is in slides.css (see
               effects.js), so a tile can only show a quiet of it, and so
               can the sample at the top of this panel. -->
          <div class="field field-effect">
            <div class="look-row look-row-wide">
              <span class="look-row-label" id="effect-label"><%= t('editor.effectOver') %></span>
              <span id="effect-name" class="look-row-value"></span>
            </div>
            <div id="effect-tiles" class="effect-tiles" role="radiogroup"
                 aria-labelledby="effect-label">
              <button type="button" class="effect-tile swatch-none" role="radio"
                      aria-checked="false" tabindex="0" data-effect=""
                      data-tip="<%= t('editor.effectNone') %>" aria-label="<%= t('editor.effectNone') %>"></button>
              <% effects.forEach(function (e) { %>
                <button type="button" class="effect-tile" role="radio"
                        aria-checked="false" tabindex="-1" data-effect="<%= e.id %>"
                        data-tip="<%= e.name %>" aria-label="<%= e.name %>"></button>
              <% }); %>
            </div>
            <p class="hint"><%= t('editor.effectNote') %></p>
          </div>
        </div>
      </div>

      <!-- Every picture in the deck's folder, with the slides it stands on
           (js/editor/library.js). One that stands on none is dimmed and
           carries the only button that can delete it -- a picture in use
           has none, here or anywhere else: the way to be rid of it is to
           take it off the slide first, which is a step one can see the
           effect of. -->
      <div id="panel-library" class="tab-panel" role="tabpanel"
           aria-labelledby="tab-library" hidden>
        <p id="library-empty" class="hint" hidden><%= t('library.empty') %></p>
        <ul id="library-list" class="library"></ul>
      </div>
    </div>
  </section>

  <!-- The whole deck as it stands in the file. It takes the place of the
       slide list and the form rather than floating over them in a dialog:
       what one does here IS the editing, for as long as it lasts, and the
       preview beside it is the thing one is checking the typing against.

       A dialog had to make room for that preview by cutting a hole in its
       own veil and being dragged aside -- a lot of machinery to arrive at
       what two columns and a seam do by standing still.

       Nothing arrives with the page: the file is fetched when the panel
       opens, so it shows what was last SAVED rather than a copy that goes
       stale with the next keystroke (js/editor/deck-source.js).

       The colouring comes from the server (source.js): the editor carries
       no highlighter, and the one in the presentation belongs to
       reveal.js. -->
  <!-- tabindex=-1 so that leaving a block with Escape has somewhere to put
       the focus: the textarea it was in is removed on the way out, and a
       focus left on a removed element falls to <body>, which is nowhere.
       Not reachable by Tab -- -1 is exactly the difference. -->
  <section id="deck-source-view" class="column source-view" hidden tabindex="-1"
           aria-label="<%= t('dialog.sourceTitle') %>">
    <!-- One row per block of the file, each with its mark on the left
         (source.js). A click turns one block into a field; the rest keep
         their colours. role=status: while the file is on its way, and if it
         never comes, this box says so itself -- and a screen reader hears it
         without the focus having to travel there. -->
    <div class="deck-source">
      <div id="deck-source-code" role="status"></div>
    </div>
    <!-- What the file would cost if it were saved as it stands (check.js).
         Only there when there is something to say; each row leads to its
         line. -->
    <div id="deck-source-findings" class="deck-source-findings" hidden>
      <p class="hint"><%= t('source.findings') %></p>
      <ul></ul>
    </div>
    <!-- Only there once something has been typed and not yet applied, which
         is the only moment there is anything to decide. It sits at the FOOT
         and under the findings on purpose: the findings are what shut the
         apply button, and an answer belongs next to its reason.

         The line beside the two buttons says what the state is. It also
         answers the question the button in the header raises while this
         bar is up -- pressing it does not go back, because going back with
         unapplied text here and a live form over there would let the two
         write the same file past each other. -->
    <div id="deck-source-actions" class="source-actions" hidden>
      <p class="hint"><%= t('source.unapplied') %></p>
      <span class="source-actions-buttons">
        <button type="button" id="deck-source-discard" class="button"><%= t('dialog.sourceDiscard') %></button>
        <button type="button" id="deck-source-apply" class="button button-haupt"><%= t('dialog.sourceApply') %></button>
      </span>
    </div>
  </section>

  <!-- The line between the form and the preview, to be taken hold of. Both
       sides want room at different moments -- a long text wants the form
       wide, a layout one is judging by eye wants the preview wide -- and
       which of the two it is, only the person in front of the screen knows.
       The form keeps a quarter of the width whatever happens (see
       js/column-split.js), because below that the form stops being usable
       at all rather than merely narrow.

       A separator, not a button: it has a position, and arrow keys move it
       for whoever is not holding a mouse. -->
  <div id="column-split" class="column-split" role="separator"
       tabindex="0" aria-orientation="vertical"
       aria-controls="slide-form preview"
       aria-valuemin="25" aria-valuemax="75"
       aria-label="<%= t('column.split') %>"
       data-tip="<%= t('column.splitHint') %>"></div>

  <!-- Right: real reveal.js, not a replica. What stands here is what
       stands on the wall later. -->
  <aside class="column preview">
    <span class="columns-head"><%= t('column.preview') %></span>
    <div class="preview-frame">
      <iframe id="preview" title="<%= t('column.preview') %>" src="<%= BASE %>/d/<%= slug %>/preview"></iframe>
      <!-- The shape of the screen the talk will run on. reveal.js fits the
           slide into whatever it is given, so putting the preview into that
           shape is the one honest way to see beforehand what a 4:3
           projector will make of a slide. The deck is untouched by it --
           see preview-format.js.

           A menu of this app's own and not a <select>: a native one brings
           the operating system's dropdown with it, which is the only thing
           on this page that does not look like this page. The button wears
           the screen and the ratio in force, the rows wear the shape they
           stand for -- in a list of ratios that picture IS the information.

           It stands IN the preview, in its bottom left corner, and shows
           itself only while the mouse is over the preview: it is a
           question one has a couple of times a talk, not something that
           should take a line of the form for good. Inside the frame it
           also opens upwards, over the slide -- downwards there is
           nothing left to open into. -->
      <details id="preview-format-menu" class="menu preview-format"
               data-tip="<%= t('editor.previewFormat') %>">
        <summary id="preview-format-button" class="button preview-format-value"
                 aria-label="<%= t('editor.previewFormat') %>"><span
                 class="preview-screen" aria-hidden="true"></span><span
                 id="preview-format-word"><%= previewDefault %></span></summary>
        <div class="menu-content" role="menu">
          <% previewFormats.forEach(function (f) { %>
            <button type="button" class="menu-item format-row" role="menuitemradio"
                    aria-checked="false" data-format="<%= f %>"><span
                    class="format-shape" aria-hidden="true"></span><%= f %></button>
          <% }); %>
        </div>
      </details>
    </div>
    <p class="hint preview-hint"><%= t('editor.previewNote') %></p>
  </aside>
</main>

<!-- Inserting a code block: language and, for this one block, a style.
     Both end up in the fence (```java hl=github), so the .md keeps saying
     what it means in any other renderer too. -->
<dialog id="code-dialog" class="dialog">
  <form method="dialog" class="dialog-head">
    <h2 id="code-title"><%= t('dialog.codeTitle') %></h2>
    <button class="button button-quiet" value="abbruch"><%= t('dialog.close') %></button>
  </form>
  <form method="dialog" class="dialog-content" id="code-form">
    <label class="field">
      <span class="field-label"><%= t('dialog.codeLanguage') %></span>
      <select id="code-language">
        <% codeLanguages.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.label %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span class="field-label"><%= t('dialog.codeStyle') %></span>
      <select id="code-style">
        <option value=""><%= t('dialog.codeStyleDefault') %></option>
        <% codeStyles.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.id %><%= s.light ? " — " + t('dialog.codeLight') : "" %></option>
        <% }); %>
      </select>
    </label>
    <label class="field">
      <span class="field-label"><%= t('dialog.codeText') %></span>
      <textarea id="code-text" class="code-eingabe" rows="8" spellcheck="false"
                placeholder="<%= t('dialog.codePlaceholder') %>"></textarea>
    </label>
    <label class="field field-schmal code-fragment-line">
      <input type="checkbox" id="code-fragment" class="switch">
      <span><%= t('dialog.codeFragment') %></span>
    </label>
    <p id="code-note" class="hint"><%= t('dialog.codeNote') %></p>
    <div class="dialog-fuss">
      <button type="button" class="button" data-close><%= t('dialog.cancel') %></button>
      <button type="submit" id="code-ok" class="button button-haupt" value="einfuegen"><%= t('dialog.codeInsert') %></button>
    </div>
  </form>
</dialog>

<!-- Notices. One dialog for all of them; the text arrives when it is opened
     (js/editor/index.js). Ours rather than the browser's alert for the same
     reason the tooltips are ours: that one cannot be styled, it names the
     host ("localhost:8888 says"), and it looks like a visitor from another
     program. -->
<!-- Leaving the editor with something the file does not have yet. The
     browser has a warning of its own for this, but it fires on the way OUT
     and cannot be styled, cannot say what is owed and offers nothing but
     "leave" and "stay" -- so the ways out that this page itself controls
     are caught before they are taken (js/editor/index.js) and asked here,
     where saving is one of the answers. The browser's own stays behind it
     for everything else: closing the tab, a reload, an address typed by
     hand. -->
<dialog id="leave-dialog" class="dialog dialog-schmal">
  <form method="dialog" class="dialog-head">
    <h2><%= t('dialog.leaveTitle') %></h2>
    <button class="button button-quiet" value="stay"><%= t('dialog.close') %></button>
  </form>
  <form method="dialog" class="dialog-content">
    <p><%= t('dialog.leaveText') %></p>
    <div class="dialog-fuss">
      <button class="button" value="leave"><%= t('dialog.leaveAnyway') %></button>
      <button class="button button-haupt" value="save" autofocus><%= t('dialog.leaveSave') %></button>
    </div>
  </form>
</dialog>

<dialog id="note-dialog" class="dialog dialog-schmal">
  <form method="dialog" class="dialog-head">
    <h2><%= t('dialog.noteTitle') %></h2>
    <button class="button button-quiet" value="ok"><%= t('dialog.close') %></button>
  </form>
  <form method="dialog" class="dialog-content">
    <p id="note-text"></p>
    <div class="dialog-fuss">
      <button class="button button-haupt" value="ok" autofocus><%= t('dialog.understood') %></button>
    </div>
  </form>
</dialog>

<!-- Image picker -->
<dialog id="image-dialog" class="dialog">
  <form method="dialog" class="dialog-head">
    <h2><%= t('editor.imageChoose') %></h2>
    <button class="button button-quiet" value="abbruch"><%= t('dialog.close') %></button>
  </form>
  <div class="dialog-content">
    <label class="button button-haupt upload">
      <%= t('editor.imageUpload') %>
      <input type="file" id="image-file" accept="image/*" multiple hidden>
    </label>
    <div id="image-gallery" class="image-gallery"></div>
    <p id="image-empty" class="hint" hidden><%= t('editor.imageNone') %></p>
  </div>
</dialog>

<script type="application/json" id="data-deck"><%- JSON.stringify(deck) %></script>
<script type="application/json" id="data-layouts"><%- JSON.stringify(layouts) %></script>
<script type="application/json" id="data-images"><%- JSON.stringify(images) %></script>
<script type="application/json" id="data-emoji"><%- JSON.stringify(emoji) %></script>
<script type="application/json" id="data-themes"><%- JSON.stringify(themeColors) %></script>
<script type="application/json" id="data-effects"><%- JSON.stringify(effects) %></script>
<script>
  window.SLIDES_BASE = <%- JSON.stringify(BASE + "/d/" + slug) %>;
  // The deck's own name in the folder. Needed where something has to be
  // kept for THIS deck across a page load -- a suggestion built on the
  // overview and carried here (js/ai-run.js).
  window.SLIDES_SLUG = <%- JSON.stringify(slug) %>;
  // The break line between two columns' texts and the name of that
  // arrangement. Both are defined on the server (layouts.js) and handed
  // over rather than written a second time (js/editor/columns.js).
  window.SLIDES_COLUMNS = <%- JSON.stringify(columns) %>;
  // Said once, when the editor opens, and only on a deck that wants a
  // newer trivialSlides than this one (routes/decks.js). A ready-made
  // sentence rather than two version numbers: comparing them is the
  // server's job, and the page has nothing to add to it.
  window.SLIDES_TOO_NEW = <%- JSON.stringify(tooNew) %>;
</script>
<script type="module" src="<%= BASE %>/static/js/editor/index.js"></script>
<%- include("partials/prefs") %>
<%- include("partials/bands") %>
<% if (ai) { %><%- include("partials/ai") %><% } %>
<%- include("partials/palette") %>

</body>
</html>
