<!doctype html>
<html lang="<%= t('html.lang') %>">
<head>
<%- include("partials/head", { titel: deck.titel || "Vortrag" }) %>
<!-- Only the editor picks colours, so the overview is spared this. -->
<link rel="stylesheet" href="<%= BASE %>/coloris/dist/coloris.css">
</head>
<body class="seite-editor">

<header class="kopf">
  <a class="marke" href="<%= BASE %>/" data-tip="<%= t('kopf.alleVortraege') %>"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32"><span class="marke-wort">trivialSlides<small class="marke-version">v<%= VERSION %></small></span></a>

  <input id="deck-titel" class="deck-titel-feld" value="<%= deck.titel %>" maxlength="120" aria-label="<%= t('kopf.titelFeld') %>">

  <label class="kopf-feld"><%= t('kopf.aussehen') %>
    <select id="deck-theme">
      <% themes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.theme ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <label class="kopf-feld"><%= t('kopf.uebergang') %>
    <select id="deck-transition">
      <% transitions.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.transition ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <span id="speicherstand" class="speicherstand" role="status"></span>

  <a class="knopf knopf-icon kopf-vorfuehren" data-tip="<%= t('kopf.vorfuehren') %>" aria-label="<%= t('kopf.vorfuehren') %>"
     href="<%= BASE %>/d/<%= slug %>/praesentation" target="_blank" rel="noopener"></a>
  <details class="menue">
    <summary class="knopf knopf-icon kopf-herunterladen" data-tip="<%= t('kopf.herunterladen') %>" aria-label="<%= t('kopf.herunterladen') %>"></summary>
    <div class="menue-inhalt">
      <a href="<%= BASE %>/d/<%= slug %>/export.html"><%= t('editor.exportHtml') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/export.pdf"><%= t('editor.exportPdf') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/vortrag.md"><%= t('editor.exportMd') %></a>
    </div>
  </details>
  <button id="sprache-umschalter" class="knopf knopf-still sprache" type="button"
      data-ziel="<%= SPRACHE === 'de' ? 'en' : 'de' %>"
      data-tip="<%= t('kopf.spracheWechseln') %>"
      aria-label="<%= t('kopf.spracheWechseln') %>"><%= SPRACHE === 'de' ? 'en' : 'de' %></button>
  <button id="theme-umschalter" class="knopf knopf-still knopf-icon" type="button"></button>
</header>

<main class="editor">

  <!-- Left: the slides as a list. Reorder by dragging. -->
  <aside class="spalte folienliste">
    <span class="spalten-kopf"><%= t('spalte.folien') %></span>
    <ol id="folienliste" class="folien"></ol>
    <button id="folie-neu" class="knopf knopf-breit" type="button"><%= t('editor.folieNeu') %></button>
  </aside>

  <!-- Middle: the form for the selected slide. Nowhere here is there any
       Markdown syntax -- that is the whole point of the exercise. -->
  <section class="spalte formular">
    <fieldset class="feldgruppe">
      <legend><%= t('editor.aufbau') %></legend>
      <div id="layout-kacheln" class="layout-kacheln">
        <% layouts.forEach(function (l) { %>
          <button type="button" class="layout-kachel" data-layout="<%= l.id %>" data-tip="<%= l.hilfe %>">
            <span class="mini mini-<%= l.id %>" aria-hidden="true"></span>
            <span class="layout-name"><%= l.label %></span>
          </button>
        <% }); %>
      </div>
      <p id="layout-hilfe" class="hilfe"></p>
    </fieldset>

    <fieldset class="feldgruppe">
      <legend><%= t('editor.inhalt') %></legend>

      <label class="feld">
        <span class="feld-name"><%= t('editor.ueberschrift') %></span>
        <input id="folie-titel" maxlength="200" placeholder="<%= t('editor.ueberschriftPlatzhalter') %>">
      </label>

      <div class="feld">
        <span class="feld-name"><%= t('editor.text') %></span>
        <div class="werkzeugleiste" role="toolbar" aria-label="<%= t('editor.werkzeugleiste') %>">
          <button type="button" class="werkzeug-icon" data-befehl="bold" data-tip="<%= t('werkzeug.fettTip') %>" aria-label="<%= t('werkzeug.fett') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="italic" data-tip="<%= t('werkzeug.kursivTip') %>" aria-label="<%= t('werkzeug.kursiv') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="strikeThrough" data-tip="<%= t('werkzeug.durchgestrichen') %>" aria-label="<%= t('werkzeug.durchgestrichen') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="insertUnorderedList" data-tip="<%= t('werkzeug.aufzaehlung') %>" aria-label="<%= t('werkzeug.aufzaehlung') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="insertOrderedList" data-tip="<%= t('werkzeug.nummeriert') %>" aria-label="<%= t('werkzeug.nummeriert') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="link" data-tip="<%= t('werkzeug.link') %>" aria-label="<%= t('werkzeug.link') %>"></button>
          <span class="leiste-trenner"></span>
          <button type="button" class="werkzeug-icon" data-befehl="fragment" data-tip="<%= t('werkzeug.fragmentTip') %>" aria-label="<%= t('werkzeug.fragment') %>"></button>
          <!-- Code is the one thing in this bar that the rich-text field
               cannot hold, so it does not run through execCommand and it
               stays usable in source mode -- that is where it lands. -->
          <button type="button" id="code-einfuegen" class="werkzeug-icon" data-tip="<%= t('werkzeug.codeTip') %>" aria-label="<%= t('werkzeug.code') %>"></button>
          <span class="leiste-trenner"></span>
          <!-- Where the text sits in relation to the player, on a video
               slide. In the bar it is the icon of the side in force and
               nothing else; the words are in the menu, where there is room
               for them. Like the code button it is not a rich-text command,
               so it keeps working in source mode. -->
          <details id="textseite-menue" class="menue menue-werkzeug"
                   data-name="<%= t('editor.textseite') %>" hidden>
            <summary id="textseite-knopf" class="werkzeug-icon werkzeug-seite" data-seite="oben"
                     aria-label="<%= t('editor.textseite') %>"></summary>
            <div class="menue-inhalt" role="menu">
              <% videoSeiten.forEach(function (s) { %>
                <button type="button" class="menue-eintrag werkzeug-seite" role="menuitemradio"
                        aria-checked="false" data-seite="<%= s.id %>"><span
                        class="menue-eintrag-icon" aria-hidden="true"></span><%= s.name %></button>
              <% }); %>
            </div>
          </details>
          <!-- How wide the text may get beside the player. A percentage
               says itself, so this one wears its value rather than an icon
               -- and it is switched off, not hidden, while the text is
               above or below the player: there it has the full width and
               the number would be a promise the slide does not keep. -->
          <!-- Two names, because the thing the text stands beside differs by
               layout: a picture on bild-links/-rechts, a player on video.
               Both travel with the button and the page picks the fitting
               one (js/editor/index.js) -- naming it after the layout on the
               server would mean re-rendering the bar on every layout
               change. -->
          <details id="textbreite-menue" class="menue menue-werkzeug" hidden
                   data-name-bild="<%= t('editor.textbreiteBild') %>"
                   data-name-video="<%= t('editor.textbreiteVideo') %>">
            <summary id="textbreite-knopf" class="werkzeug-wort"></summary>
            <div class="menue-inhalt" role="menu">
              <% textbreiten.forEach(function (b) { %>
                <button type="button" class="menue-eintrag" role="menuitemradio"
                        aria-checked="false" data-breite="<%= b %>"><%= b %>&nbsp;%</button>
              <% }); %>
            </div>
          </details>
          <span class="leiste-trenner"></span>
          <button type="button" id="quelltext-umschalten" class="werkzeug-icon" data-tip="<%= t('werkzeug.quelltextTip') %>" aria-label="<%= t('werkzeug.quelltext') %>"></button>
        </div>
        <!-- The frame, not the field, is what scrolls: OverlayScrollbars
             builds its own DOM inside whatever it is attached to, and the
             editor reads the content field's innerHTML back as Markdown. -->
        <div id="inhalt-rahmen" class="feld-rahmen">
          <div id="folie-inhalt" class="inhalt-feld" contenteditable="true" spellcheck="true"
               data-platzhalter="<%= t('editor.textPlatzhalter') %>"></div>
        </div>
        <div id="quelltext-rahmen" class="feld-rahmen" hidden>
          <textarea id="folie-quelltext" class="quelltext-feld" spellcheck="false"></textarea>
        </div>
        <p id="quelltext-hinweis" class="hilfe" hidden>
          <%= t('editor.quelltextHinweis') %>
        </p>
      </div>

      <div class="feld feld-bild" hidden>
        <span class="feld-name"><%= t('editor.bild') %></span>
        <div class="bild-zeile">
          <img id="bild-vorschau" class="bild-vorschau" alt="" hidden>
          <div class="bild-knoepfe">
            <button type="button" id="bild-waehlen" class="knopf"><%= t('editor.bildWaehlen') %></button>
            <button type="button" id="bild-entfernen" class="knopf knopf-still" hidden><%= t('editor.bildEntfernen') %></button>
          </div>
        </div>
      </div>

      <!-- The link as it sits in the clipboard; what lands in the file is
           the id inside it (video.js). The pattern is the server's, so the
           page recognises a link the same way the server does. -->
      <label class="feld feld-video" hidden>
        <span class="feld-name"><%= t('editor.video') %></span>
        <input id="folie-video" type="text" maxlength="200" spellcheck="false"
               placeholder="<%= t('editor.videoPlatzhalter') %>"
               data-muster="<%= videoMuster %>">
        <span id="video-hinweis" class="hilfe"></span>
      </label>

      <label class="feld feld-quelle" hidden>
        <span class="feld-name"><%= t('editor.quelle') %></span>
        <input id="folie-quelle" maxlength="200" placeholder="<%= t('editor.quellePlatzhalter') %>">
      </label>
    </fieldset>

    <!-- Colours, gradient and effect are the things one reaches for after a
         while, not at the start -- so the group folds away, and starts
         folded. <details> rather than a button of our own: the browser
         brings the keyboard, the marker and the semantics with it. The
         choice is remembered (js/editor/index.js), because someone who has
         opened it once is usually past the start. -->
    <details id="farben-gruppe" class="feldgruppe feldgruppe-klapp">
      <summary>
        <%= t('editor.farben') %>
        <span class="klapp-marke" data-tip="<%= t('editor.farbenEigen') %>"
              aria-label="<%= t('editor.farbenEigen') %>"></span>
      </summary>
      <div class="farbzeile">
        <label class="farbwahl">
          <input id="hintergrund-eigen" class="farbfeld" type="text" value="" aria-label="<%= t('editor.hintergrund') %>">
          <span><%= t('editor.hintergrund') %></span>
        </label>
        <label class="farbwahl">
          <input id="textfarbe-eigen" class="farbfeld" type="text" value="" aria-label="<%= t('editor.textfarbe') %>">
          <span><%= t('editor.textfarbe') %></span>
        </label>
      </div>

      <!-- The gradient, twice over: the swatches for picking one, the field
           below for writing one. The swatches come from verlaeufe.js, which
           a deck collection extends through decks/verlaeufe.json -- so this
           row is as long as someone made it, not eight items by design.
           Each swatch wears its own gradient, which is why the value is in
           the style attribute: a stylesheet cannot know them. -->
      <div class="feld feld-verlauf">
        <span class="feld-name"><%= t('editor.verlauf') %></span>
        <div id="verlauf-vorlagen" class="verlauf-vorlagen" role="group" aria-label="<%= t('editor.verlaufVorlagen') %>">
          <button type="button" class="verlauf-probe verlauf-ohne" data-verlauf=""
                  data-tip="<%= t('editor.verlaufOhne') %>" aria-label="<%= t('editor.verlaufOhne') %>"></button>
          <% verlaeufe.forEach(function (v) { %>
            <button type="button" class="verlauf-probe" data-verlauf="<%= v.css %>"
                    style="background-image: <%= v.css %>"
                    data-tip="<%= v.name %>" aria-label="<%= v.name %>"></button>
          <% }); %>
        </div>
        <input id="folie-verlauf" class="verlauf-feld" type="text" spellcheck="false"
               maxlength="<%= verlaufMax %>" pattern="<%= verlaufMuster %>"
               placeholder="<%= t('editor.verlaufPlatzhalter') %>" aria-label="<%= t('editor.verlaufEigen') %>">
        <p id="verlauf-hilfe" class="hilfe"><%= t('editor.verlaufHinweis') %></p>
      </div>

      <!-- Animated backgrounds. A name, not a value -- what it looks like
           is in slides.css (see effekte.js), so a tile can only show a
           still of it. -->
      <div class="feld feld-effekt">
        <span class="feld-name"><%= t('editor.effekt') %></span>
        <div id="effekt-kacheln" class="effekt-kacheln" role="group" aria-label="<%= t('editor.effekt') %>">
          <button type="button" class="effekt-kachel effekt-ohne" data-effect=""
                  data-tip="<%= t('editor.effektOhne') %>" aria-label="<%= t('editor.effektOhne') %>"></button>
          <% effekte.forEach(function (e) { %>
            <button type="button" class="effekt-kachel" data-effect="<%= e.id %>"
                    data-tip="<%= e.name %>" aria-label="<%= e.name %>"></button>
          <% }); %>
        </div>
        <p class="hilfe"><%= t('editor.effektHinweis') %></p>
      </div>
    </details>
  </section>

  <!-- Right: real reveal.js, not a replica. What stands here is what
       stands on the wall later. -->
  <aside class="spalte vorschau">
    <span class="spalten-kopf"><%= t('spalte.vorschau') %></span>
    <div class="vorschau-rahmen">
      <iframe id="vorschau" title="<%= t('spalte.vorschau') %>" src="<%= BASE %>/d/<%= slug %>/vorschau"></iframe>
    </div>
    <p class="hilfe vorschau-hilfe"><%= t('editor.vorschauHinweis') %></p>
  </aside>
</main>

<!-- Inserting a code block: language and, for this one block, a style.
     Both end up in the fence (```java hl=github), so the .md keeps saying
     what it means in any other renderer too. -->
<dialog id="code-dialog" class="dialog">
  <form method="dialog" class="dialog-kopf">
    <h2 id="code-titel"><%= t('dialog.codeTitel') %></h2>
    <button class="knopf knopf-still" value="abbruch"><%= t('dialog.schliessen') %></button>
  </form>
  <form method="dialog" class="dialog-inhalt" id="code-form">
    <label class="feld">
      <span class="feld-name"><%= t('dialog.codeSprache') %></span>
      <select id="code-sprache">
        <% codeSprachen.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.label %></option>
        <% }); %>
      </select>
    </label>
    <label class="feld">
      <span class="feld-name"><%= t('dialog.codeStil') %></span>
      <select id="code-stil">
        <option value=""><%= t('dialog.codeStilStandard') %></option>
        <% codeStile.forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.id %><%= s.light ? " — " + t('dialog.codeHell') : "" %></option>
        <% }); %>
      </select>
    </label>
    <label class="feld">
      <span class="feld-name"><%= t('dialog.codeText') %></span>
      <textarea id="code-text" class="code-eingabe" rows="8" spellcheck="false"
                placeholder="<%= t('dialog.codePlatzhalter') %>"></textarea>
    </label>
    <label class="feld feld-schmal code-fragment-zeile">
      <input type="checkbox" id="code-fragment">
      <span><%= t('dialog.codeFragment') %></span>
    </label>
    <p id="code-hinweis" class="hilfe"><%= t('dialog.codeHinweis') %></p>
    <div class="dialog-fuss">
      <button type="button" class="knopf" data-schliessen><%= t('dialog.abbrechen') %></button>
      <button type="submit" id="code-ok" class="knopf knopf-haupt" value="einfuegen"><%= t('dialog.codeEinfuegen') %></button>
    </div>
  </form>
</dialog>

<!-- Notices. One dialog for all of them; the text arrives when it is opened
     (js/editor/index.js). Ours rather than the browser's alert for the same
     reason the tooltips are ours: that one cannot be styled, it names the
     host ("localhost:8888 says"), and it looks like a visitor from another
     program. -->
<dialog id="hinweis-dialog" class="dialog dialog-schmal">
  <form method="dialog" class="dialog-kopf">
    <h2><%= t('dialog.hinweisTitel') %></h2>
    <button class="knopf knopf-still" value="ok"><%= t('dialog.schliessen') %></button>
  </form>
  <form method="dialog" class="dialog-inhalt">
    <p id="hinweis-text"></p>
    <div class="dialog-fuss">
      <button class="knopf knopf-haupt" value="ok" autofocus><%= t('dialog.verstanden') %></button>
    </div>
  </form>
</dialog>

<!-- Image picker -->
<dialog id="bild-dialog" class="dialog">
  <form method="dialog" class="dialog-kopf">
    <h2><%= t('editor.bildWaehlen') %></h2>
    <button class="knopf knopf-still" value="abbruch"><%= t('dialog.schliessen') %></button>
  </form>
  <div class="dialog-inhalt">
    <label class="knopf knopf-haupt hochladen">
      <%= t('editor.bildHochladen') %>
      <input type="file" id="bild-datei" accept="image/*" multiple hidden>
    </label>
    <div id="bild-galerie" class="bild-galerie"></div>
    <p id="bild-leer" class="hilfe" hidden><%= t('editor.bildKeine') %></p>
  </div>
</dialog>

<script type="application/json" id="daten-deck"><%- JSON.stringify(deck) %></script>
<script type="application/json" id="daten-layouts"><%- JSON.stringify(layouts) %></script>
<script type="application/json" id="daten-bilder"><%- JSON.stringify(bilder) %></script>
<script>window.FOLIEN_BASIS = <%- JSON.stringify(BASE + "/d/" + slug) %>;</script>
<script type="module" src="<%= BASE %>/static/js/editor/index.js"></script>
</body>
</html>
