<!doctype html>
<html lang="de">
<head>
<%- include("partials/head", { titel: deck.titel || "Vortrag" }) %>
</head>
<body class="seite-editor">

<header class="kopf">
  <a class="marke" href="<%= BASE %>/" title="Alle Vortraege">trivialSlides</a>

  <input id="deck-titel" class="deck-titel-feld" value="<%= deck.titel %>" maxlength="120" aria-label="Titel des Vortrags">

  <label class="kopf-feld">Aussehen
    <select id="deck-theme">
      <% themes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.theme ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <label class="kopf-feld">Uebergang
    <select id="deck-transition">
      <% transitions.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.transition ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <span id="speicherstand" class="speicherstand" role="status">Gespeichert</span>

  <a class="knopf knopf-haupt" href="<%= BASE %>/d/<%= slug %>/praesentation" target="_blank" rel="noopener">Vorfuehren</a>
  <details class="menue">
    <summary class="knopf">Herunterladen</summary>
    <div class="menue-inhalt">
      <a href="<%= BASE %>/d/<%= slug %>/export.html">Eine HTML-Datei (laeuft ohne alles)</a>
      <a href="<%= BASE %>/d/<%= slug %>/export.pdf">PDF zum Austeilen (dauert einen Moment)</a>
      <a href="<%= BASE %>/d/<%= slug %>/vortrag.md">Markdown-Datei</a>
    </div>
  </details>
</header>

<main class="editor">

  <!-- Left: the slides as a list. Reorder by dragging. -->
  <aside class="spalte folienliste">
    <ol id="folienliste" class="folien"></ol>
    <button id="folie-neu" class="knopf knopf-breit" type="button">+ Folie hinzufuegen</button>
  </aside>

  <!-- Middle: the form for the selected slide. Nowhere here is there any
       Markdown syntax -- that is the whole point of the exercise. -->
  <section class="spalte formular">
    <fieldset class="feldgruppe">
      <legend>Aufbau der Folie</legend>
      <div id="layout-kacheln" class="layout-kacheln">
        <% layouts.forEach(function (l) { %>
          <button type="button" class="layout-kachel" data-layout="<%= l.id %>" title="<%= l.hilfe %>">
            <span class="mini mini-<%= l.id %>" aria-hidden="true"></span>
            <span class="layout-name"><%= l.label %></span>
          </button>
        <% }); %>
      </div>
      <p id="layout-hilfe" class="hilfe"></p>
    </fieldset>

    <fieldset class="feldgruppe">
      <legend>Inhalt</legend>

      <label class="feld">
        <span class="feld-name">Ueberschrift</span>
        <input id="folie-titel" maxlength="200" placeholder="Worum geht es auf dieser Folie?">
      </label>

      <div class="feld">
        <span class="feld-name">Text</span>
        <div class="werkzeugleiste" role="toolbar" aria-label="Textformatierung">
          <button type="button" data-befehl="bold" title="Fett (Strg+B)"><b>F</b></button>
          <button type="button" data-befehl="italic" title="Kursiv (Strg+I)"><i>K</i></button>
          <button type="button" data-befehl="insertUnorderedList" title="Aufzaehlung">&bull; Liste</button>
          <button type="button" data-befehl="insertOrderedList" title="Nummerierte Liste">1. Liste</button>
          <button type="button" data-befehl="link" title="Link einfuegen">Link</button>
          <span class="leiste-trenner"></span>
          <button type="button" data-befehl="fragment" title="Diesen Absatz erst auf Klick einblenden">Nacheinander einblenden</button>
          <span class="leiste-trenner"></span>
          <button type="button" id="quelltext-umschalten" title="Zeigt die Folie als Markdown">Quelltext</button>
        </div>
        <div id="folie-inhalt" class="inhalt-feld" contenteditable="true" spellcheck="true"
             data-platzhalter="Schreib hier den Text der Folie."></div>
        <textarea id="folie-quelltext" class="quelltext-feld" hidden spellcheck="false"></textarea>
        <p id="quelltext-hinweis" class="hilfe" hidden>
          Diese Folie enthaelt Markdown, das die Formatierknoepfe nicht abbilden koennen
          (z.B. eine Tabelle oder Code). Sie wird deshalb als Quelltext bearbeitet.
        </p>
      </div>

      <div class="feld feld-bild" hidden>
        <span class="feld-name">Bild</span>
        <div class="bild-zeile">
          <img id="bild-vorschau" class="bild-vorschau" alt="" hidden>
          <div class="bild-knoepfe">
            <button type="button" id="bild-waehlen" class="knopf">Bild waehlen</button>
            <button type="button" id="bild-entfernen" class="knopf knopf-still" hidden>Entfernen</button>
          </div>
        </div>
      </div>

      <label class="feld feld-quelle" hidden>
        <span class="feld-name">Quelle</span>
        <input id="folie-quelle" maxlength="200" placeholder="Wer hat das gesagt?">
      </label>
    </fieldset>

    <fieldset class="feldgruppe">
      <legend>Hintergrund dieser Folie</legend>
      <div id="hintergrund-farben" class="farbwahl">
        <button type="button" class="farbe farbe-standard" data-farbe="" title="Wie der Rest des Vortrags"></button>
      </div>
      <label class="feld feld-schmal">
        <span class="feld-name">Eigene Farbe</span>
        <input id="hintergrund-eigen" type="color" value="#ffffff">
      </label>
    </fieldset>
  </section>

  <!-- Right: real reveal.js, not a replica. What stands here is what
       stands on the wall later. -->
  <aside class="spalte vorschau">
    <div class="vorschau-rahmen">
      <iframe id="vorschau" title="Vorschau" src="<%= BASE %>/d/<%= slug %>/vorschau"></iframe>
    </div>
    <p class="hilfe vorschau-hilfe">Das ist die Folie, wie sie an der Wand aussieht.</p>
  </aside>
</main>

<!-- Image picker -->
<dialog id="bild-dialog" class="dialog">
  <form method="dialog" class="dialog-kopf">
    <h2>Bild waehlen</h2>
    <button class="knopf knopf-still" value="abbruch">Schliessen</button>
  </form>
  <div class="dialog-inhalt">
    <label class="knopf knopf-haupt hochladen">
      Bild hochladen
      <input type="file" id="bild-datei" accept="image/*" multiple hidden>
    </label>
    <div id="bild-galerie" class="bild-galerie"></div>
    <p id="bild-leer" class="hilfe" hidden>Noch keine Bilder in diesem Vortrag.</p>
  </div>
</dialog>

<script type="application/json" id="daten-deck"><%- JSON.stringify(deck) %></script>
<script type="application/json" id="daten-layouts"><%- JSON.stringify(layouts) %></script>
<script type="application/json" id="daten-bilder"><%- JSON.stringify(bilder) %></script>
<script>window.FOLIEN_BASIS = <%- JSON.stringify(BASE + "/d/" + slug) %>;</script>
<script type="module" src="<%= BASE %>/static/js/editor/index.js"></script>
</body>
</html>
