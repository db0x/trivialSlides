<!doctype html>
<html lang="<%= t('html.lang') %>">
<head>
<%- include("partials/head", { titel: deck.titel || "Vortrag" }) %>
<!-- Only the editor picks colours, so the overview is spared this. -->
<link rel="stylesheet" href="<%= BASE %>/coloris/dist/coloris.css">
</head>
<body class="seite-editor">

<header class="kopf">
  <a class="marke" href="<%= BASE %>/" data-tip="<%= t('kopf.alleVortraege') %>"><img src="<%= BASE %>/static/trivialSlides.svg" alt="" width="32" height="32">trivialSlides</a>

  <input id="deck-titel" class="deck-titel-feld" value="<%= deck.titel %>" maxlength="120" aria-label="<%= t('kopf.titelFeld') %>">

  <label class="kopf-feld"><%= t('kopf.aussehen') %>
    <select id="deck-theme">
      <% themes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.theme ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <label class="kopf-feld"><%= t('kopf.uebergang') %>
    <select id="deck-transition">
      <% transitions.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === deck.transition ? "selected" : "" %>><%= t %></option>
      <% }); %>
    </select>
  </label>

  <span id="speicherstand" class="speicherstand" role="status"></span>

  <a class="knopf knopf-icon kopf-vorfuehren" data-tip="<%= t('kopf.vorfuehren') %>" aria-label="<%= t('kopf.vorfuehren') %>"
     href="<%= BASE %>/d/<%= slug %>/praesentation" target="_blank" rel="noopener"></a>
  <details class="menue">
    <summary class="knopf knopf-icon kopf-herunterladen" data-tip="<%= t('kopf.herunterladen') %>" aria-label="<%= t('kopf.herunterladen') %>"></summary>
    <div class="menue-inhalt">
      <a href="<%= BASE %>/d/<%= slug %>/export.html"><%= t('editor.exportHtml') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/export.pdf"><%= t('editor.exportPdf') %></a>
      <a href="<%= BASE %>/d/<%= slug %>/vortrag.md"><%= t('editor.exportMd') %></a>
    </div>
  </details>
  <button id="sprache-umschalter" class="knopf knopf-still sprache" type="button"
      data-ziel="<%= SPRACHE === 'de' ? 'en' : 'de' %>"
      data-tip="<%= t('kopf.spracheWechseln') %>"
      aria-label="<%= t('kopf.spracheWechseln') %>"><%= SPRACHE === 'de' ? 'en' : 'de' %></button>
  <button id="theme-umschalter" class="knopf knopf-still knopf-icon" type="button"></button>
</header>

<main class="editor">

  <!-- Left: the slides as a list. Reorder by dragging. -->
  <aside class="spalte folienliste">
    <span class="spalten-kopf"><%= t('spalte.folien') %></span>
    <ol id="folienliste" class="folien"></ol>
    <button id="folie-neu" class="knopf knopf-breit" type="button"><%= t('editor.folieNeu') %></button>
  </aside>

  <!-- Middle: the form for the selected slide. Nowhere here is there any
       Markdown syntax -- that is the whole point of the exercise. -->
  <section class="spalte formular">
    <fieldset class="feldgruppe">
      <legend><%= t('editor.aufbau') %></legend>
      <div id="layout-kacheln" class="layout-kacheln">
        <% layouts.forEach(function (l) { %>
          <button type="button" class="layout-kachel" data-layout="<%= l.id %>" data-tip="<%= l.hilfe %>">
            <span class="mini mini-<%= l.id %>" aria-hidden="true"></span>
            <span class="layout-name"><%= l.label %></span>
          </button>
        <% }); %>
      </div>
      <p id="layout-hilfe" class="hilfe"></p>
    </fieldset>

    <fieldset class="feldgruppe">
      <legend><%= t('editor.inhalt') %></legend>

      <label class="feld">
        <span class="feld-name"><%= t('editor.ueberschrift') %></span>
        <input id="folie-titel" maxlength="200" placeholder="<%= t('editor.ueberschriftPlatzhalter') %>">
      </label>

      <div class="feld">
        <span class="feld-name"><%= t('editor.text') %></span>
        <div class="werkzeugleiste" role="toolbar" aria-label="<%= t('editor.werkzeugleiste') %>">
          <button type="button" class="werkzeug-icon" data-befehl="bold" data-tip="<%= t('werkzeug.fettTip') %>" aria-label="<%= t('werkzeug.fett') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="italic" data-tip="<%= t('werkzeug.kursivTip') %>" aria-label="<%= t('werkzeug.kursiv') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="strikeThrough" data-tip="<%= t('werkzeug.durchgestrichen') %>" aria-label="<%= t('werkzeug.durchgestrichen') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="insertUnorderedList" data-tip="<%= t('werkzeug.aufzaehlung') %>" aria-label="<%= t('werkzeug.aufzaehlung') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="insertOrderedList" data-tip="<%= t('werkzeug.nummeriert') %>" aria-label="<%= t('werkzeug.nummeriert') %>"></button>
          <button type="button" class="werkzeug-icon" data-befehl="link" data-tip="<%= t('werkzeug.link') %>" aria-label="<%= t('werkzeug.link') %>"></button>
          <span class="leiste-trenner"></span>
          <button type="button" class="werkzeug-icon" data-befehl="fragment" data-tip="<%= t('werkzeug.fragmentTip') %>" aria-label="<%= t('werkzeug.fragment') %>"></button>
          <span class="leiste-trenner"></span>
          <button type="button" id="quelltext-umschalten" class="werkzeug-icon" data-tip="<%= t('werkzeug.quelltextTip') %>" aria-label="<%= t('werkzeug.quelltext') %>"></button>
        </div>
        <!-- The frame, not the field, is what scrolls: OverlayScrollbars
             builds its own DOM inside whatever it is attached to, and the
             editor reads the content field's innerHTML back as Markdown. -->
        <div id="inhalt-rahmen" class="feld-rahmen">
          <div id="folie-inhalt" class="inhalt-feld" contenteditable="true" spellcheck="true"
               data-platzhalter="<%= t('editor.textPlatzhalter') %>"></div>
        </div>
        <div id="quelltext-rahmen" class="feld-rahmen" hidden>
          <textarea id="folie-quelltext" class="quelltext-feld" spellcheck="false"></textarea>
        </div>
        <p id="quelltext-hinweis" class="hilfe" hidden>
          <%= t('editor.quelltextHinweis') %>
        </p>
      </div>

      <div class="feld feld-bild" hidden>
        <span class="feld-name"><%= t('editor.bild') %></span>
        <div class="bild-zeile">
          <img id="bild-vorschau" class="bild-vorschau" alt="" hidden>
          <div class="bild-knoepfe">
            <button type="button" id="bild-waehlen" class="knopf"><%= t('editor.bildWaehlen') %></button>
            <button type="button" id="bild-entfernen" class="knopf knopf-still" hidden><%= t('editor.bildEntfernen') %></button>
          </div>
        </div>
      </div>

      <label class="feld feld-quelle" hidden>
        <span class="feld-name"><%= t('editor.quelle') %></span>
        <input id="folie-quelle" maxlength="200" placeholder="<%= t('editor.quellePlatzhalter') %>">
      </label>
    </fieldset>

    <fieldset class="feldgruppe">
      <legend><%= t('editor.farben') %></legend>
      <div class="farbzeile">
        <label class="farbwahl">
          <input id="hintergrund-eigen" class="farbfeld" type="text" value="" aria-label="<%= t('editor.hintergrund') %>">
          <span><%= t('editor.hintergrund') %></span>
        </label>
        <label class="farbwahl">
          <input id="textfarbe-eigen" class="farbfeld" type="text" value="" aria-label="<%= t('editor.textfarbe') %>">
          <span><%= t('editor.textfarbe') %></span>
        </label>
      </div>
    </fieldset>
  </section>

  <!-- Right: real reveal.js, not a replica. What stands here is what
       stands on the wall later. -->
  <aside class="spalte vorschau">
    <span class="spalten-kopf"><%= t('spalte.vorschau') %></span>
    <div class="vorschau-rahmen">
      <iframe id="vorschau" title="<%= t('spalte.vorschau') %>" src="<%= BASE %>/d/<%= slug %>/vorschau"></iframe>
    </div>
    <p class="hilfe vorschau-hilfe"><%= t('editor.vorschauHinweis') %></p>
  </aside>
</main>

<!-- Image picker -->
<dialog id="bild-dialog" class="dialog">
  <form method="dialog" class="dialog-kopf">
    <h2><%= t('editor.bildWaehlen') %></h2>
    <button class="knopf knopf-still" value="abbruch"><%= t('dialog.schliessen') %></button>
  </form>
  <div class="dialog-inhalt">
    <label class="knopf knopf-haupt hochladen">
      <%= t('editor.bildHochladen') %>
      <input type="file" id="bild-datei" accept="image/*" multiple hidden>
    </label>
    <div id="bild-galerie" class="bild-galerie"></div>
    <p id="bild-leer" class="hilfe" hidden><%= t('editor.bildKeine') %></p>
  </div>
</dialog>

<script type="application/json" id="daten-deck"><%- JSON.stringify(deck) %></script>
<script type="application/json" id="daten-layouts"><%- JSON.stringify(layouts) %></script>
<script type="application/json" id="daten-bilder"><%- JSON.stringify(bilder) %></script>
<script>window.FOLIEN_BASIS = <%- JSON.stringify(BASE + "/d/" + slug) %>;</script>
<script type="module" src="<%= BASE %>/static/js/editor/index.js"></script>
</body>
</html>
