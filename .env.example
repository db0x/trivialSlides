# Port the editor is reachable on in the browser
PORT=8080

# Which address to listen on. 127.0.0.1 = this machine only,
# 0.0.0.0 = reachable across the LAN (needed for working together).
BIND_ADDR=127.0.0.1

# Which account the container runs under. It has to be yours, or the decks
# it writes end up belonging to somebody else -- with root that means they
# cannot be edited or backed up without sudo. `id -u` and `id -g` tell you
# the numbers; on most systems the first account is 1000.
APP_UID=1000
APP_GID=1000

# Where the decks live on the host. Inside the container they are always
# under /data/decks -- the compose file sets that itself.
DECKS_HOST=./decks

# Sub-path in case a reverse proxy sits in front (e.g. /folien)
BASE_PATH=

# The public address including BASE_PATH, e.g. https://talks.example.com/folien.
# Only the link preview cards need it (Slack, Teams, Mastodon): those demand
# absolute URLs, and behind a proxy the app cannot know its own public name.
# Left empty, the address is taken from the request -- fine locally, wrong
# behind a proxy.
PUBLIC_URL=

# Browser used to print the PDF export. The container already ships
# Chromium; this line is only needed by anyone who wants a different one,
# or who runs the app without Docker and keeps their browser elsewhere.
# BROWSER_PATH=/usr/bin/chromium

# --- Building a deck from a prompt -------------------------------------
# The one feature that talks to a service outside this app. It is off until
# it is pointed at a language model: without one there is no route and no
# button -- absent rather than disabled, the same way the PDF export is
# absent where no browser was found. Everything else works regardless, so
# these lines can stay commented out for good.
#
# WHICH model is deliberately not this project's business. Two request
# shapes cover nearly the whole field:
#
#   AI_API=anthropic   Claude. The default.
#   AI_API=openai      The shape OpenAI established and almost everyone
#                      else speaks: OpenAI, Mistral, Groq, Together,
#                      OpenRouter, vLLM -- and the local servers, Ollama
#                      and LM Studio, which cost nothing at all.
#
# Pick one of the three blocks below.

# 1. Claude. AI_MODEL may be left out; it is claude-sonnet-5-5 then --
#    deliberately the fast one, because the file format has a validator in
#    front of it and a smaller model simply takes one more round when it
#    slips. Note that an API key is NOT the same thing as a Claude
#    subscription: it is billed separately, from credit bought at
#    console.anthropic.com.
# AI_API=anthropic
# AI_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5

# 2. A model on your own machine, e.g. Ollama. No key, no bill. From
#    INSIDE the container the host is not localhost -- that would be the
#    container itself -- so use host.docker.internal. Small models struggle
#    with this format: it is a grammar of eleven layouts and the prompt
#    that carries it is some four thousand tokens. From roughly 14B upwards
#    is worth trying.
# AI_API=openai
# AI_URL=http://host.docker.internal:11434/v1/chat/completions
# AI_MODEL=qwen2.5:32b

# 3. Anyone else speaking that shape -- Mistral, Groq, Together,
#    OpenRouter. They differ only in the address, the key and how the model
#    is named; take both from that provider's own documentation.
# AI_API=openai
# AI_URL=https://<the provider>/v1/chat/completions
# AI_KEY=
# AI_MODEL=<as that provider names it>

# ANTHROPIC_API_KEY is read as well, so a machine that already exports it
# for other tools needs nothing new. AI_KEY wins where both are set.
# ANTHROPIC_API_KEY=

# How often the model may be handed its own mistakes before the result is
# shown as it stands. The check reports which lines the reader would throw
# away and why, and that goes back to the model -- which is what makes the
# decks come out valid rather than nearly valid. Two is enough in practice.
# AI_ROUNDS=2

# A fuse, per hour and per process. This app has no login of its own, so an
# endpoint that spends money on every call must not be able to spend faster
# than a person can click. Raise it where the app sits behind a login, or
# where the model is local and a call costs nothing.
# AI_PER_HOUR=30
